initSort("checkMdiSequence","mdiSequenceStatus","pharm_1_4_mdi_sequence");

const caseActivity=document.getElementById("case");
caseActivity.querySelectorAll(".case-option").forEach(btn=>btn.addEventListener("click",()=>{
  if(caseActivity.dataset.complete==="true")return;
  const feedback=caseActivity.querySelector(".quiz-feedback");
  caseActivity.querySelectorAll(".case-option").forEach(b=>b.classList.remove("incorrect-choice"));
  if(btn.dataset.correct==="true"){
    btn.classList.add("correct-choice");caseActivity.querySelectorAll(".case-option").forEach(b=>b.disabled=true);
    feedback.className="quiz-feedback show";feedback.style.background="var(--airway-mint)";
    feedback.innerHTML=btn.dataset.feedback+"<br><br><strong>Correct answer locked in.</strong>";
    document.getElementById("caseStatus").textContent="Clinical case complete.";document.getElementById("caseStatus").classList.add("complete");
    markActivityComplete(caseActivity);
  }else{
    btn.classList.add("incorrect-choice");feedback.className="quiz-feedback show";feedback.style.background="var(--soft-coral)";
    feedback.innerHTML=btn.dataset.feedback+"<br><br><strong>Try again.</strong>";
  }
}));

const knowledge=document.getElementById("knowledge-check"),answered=new Set();
knowledge.querySelectorAll(".knowledge-option").forEach(btn=>btn.addEventListener("click",()=>{
  const q=btn.closest(".knowledge-question");if(q.dataset.done==="true")return;
  const feedback=q.querySelector(".quiz-feedback");
  q.querySelectorAll(".knowledge-option").forEach(b=>b.classList.remove("incorrect-choice"));
  if(btn.dataset.correct==="true"){
    q.dataset.done="true";answered.add(btn.dataset.question);
    q.querySelectorAll(".knowledge-option").forEach(b=>{b.disabled=true;if(b.dataset.correct==="true")b.classList.add("correct-choice")});
    feedback.className="quiz-feedback show";feedback.style.background="var(--airway-mint)";
    feedback.innerHTML=btn.dataset.feedback+"<br><br><strong>Correct answer locked in.</strong>";
  }else{
    btn.classList.add("incorrect-choice");feedback.className="quiz-feedback show";feedback.style.background="var(--soft-coral)";
    feedback.innerHTML=btn.dataset.feedback+"<br><br><strong>Try again.</strong>";
  }
  const status=document.getElementById("knowledgeStatus");status.textContent=`${answered.size} / 6 questions answered correctly`;
  if(answered.size===6){status.textContent="Knowledge check complete.";status.classList.add("complete");markActivityComplete(knowledge)}
}));

function shuffleArray(arr){for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}return arr}
document.querySelectorAll('[data-activity-id="pharm_1_4_particle_match"] select,[data-activity-id="pharm_1_4_mdi_sequence"] select').forEach(select=>{
  const placeholder=select.options[0],others=shuffleArray(Array.from(select.options).slice(1).map(o=>({value:o.value,text:o.text})));
  select.innerHTML="";const p=document.createElement("option");p.value=placeholder.value;p.text=placeholder.text;select.appendChild(p);
  others.forEach(x=>{const o=document.createElement("option");o.value=x.value;o.text=x.text;select.appendChild(o)});
});

const masteryDeck=[
{term:"Penetration",definition:"The depth an aerosol travels into the respiratory tract."},
{term:"Deposition",definition:"The location where an aerosol particle leaves the gas stream and remains on an airway or alveolar surface."},
{term:"Inertial impaction",definition:"Deposition of larger or faster particles when they cannot follow an airway turn."},
{term:"Sedimentation",definition:"Particle settling caused by gravity, especially during low flow or a breath hold."},
{term:"Diffusion",definition:"Random movement of very small particles that can promote peripheral deposition or exhalation."},
{term:"Respirable particle",definition:"A particle generally in the 1–5 μm range that can reach lower airways."},
{term:"MDI",definition:"A metered-dose inhaler that releases a measured aerosol plume from a pressurized canister."},
{term:"Spacer",definition:"An extension device that slows an MDI plume and reduces upper-airway impaction."},
{term:"Valved holding chamber",definition:"A spacer with a one-way valve that temporarily holds aerosol and reduces coordination demands."},
{term:"DPI",definition:"A dry-powder inhaler that depends on the patient's inspiratory flow to disperse medication."},
{term:"SVN",definition:"A small-volume nebulizer that converts liquid medication into aerosol, often using compressed gas."},
{term:"BAN",definition:"A breath-actuated nebulizer that produces aerosol mainly during inspiration."},
{term:"Priming",definition:"Preparing an inhaler after first use or a period of nonuse so the next actuation contains the intended dose."},
{term:"Mucolytic",definition:"A medication that reduces mucus viscosity or disrupts mucus structure."},
{term:"Electrostatic charge",definition:"Static attraction within some chambers that can pull aerosol particles onto the device wall."},
{term:"HME",definition:"A heat-and-moisture exchanger that can trap aerosol if left in the medication path."},
{term:"Auto-PEEP",definition:"Pressure caused by incomplete exhalation before the next breath begins."},
{term:"Continuous albuterol",definition:"High-dose ongoing beta-2 agonist therapy requiring monitoring for tachycardia, arrhythmia, tremor, and hypokalemia."}
];
const masteredCards=new Set();let deckView="active",deckIndex=0,cardFlipped=false;
const cardEl=document.getElementById("masteryFlashcard"),termEl=document.getElementById("cardTerm"),definitionEl=document.getElementById("cardDefinition");
const progressText=document.getElementById("progressText"),progressFill=document.getElementById("progressFill"),completedList=document.getElementById("completedList");
function currentDeck(){
  if(deckView==="completed")return masteryDeck.map((card,index)=>({card,index})).filter(x=>masteredCards.has(x.index));
  if(deckView==="all")return masteryDeck.map((card,index)=>({card,index}));
  return masteryDeck.map((card,index)=>({card,index})).filter(x=>!masteredCards.has(x.index));
}
function updateMasteryProgress(){progressText.textContent=`Progress: ${masteredCards.size} / ${masteryDeck.length} mastered`;progressFill.style.width=`${masteredCards.size/masteryDeck.length*100}%`}
function renderCompletedList(){
  const completed=[...masteredCards].map(i=>masteryDeck[i]);
  completedList.innerHTML=completed.length?'<strong>Mastered terms:</strong><ul>'+completed.map(c=>`<li><strong>${c.term}</strong> — ${c.definition}</li>`).join("")+'</ul>':'<div class="empty-state">No cards mastered yet. Keep reviewing.</div>';
}
function renderMasteryCard(){
  const deck=currentDeck();completedList.classList.toggle("show",deckView==="completed");
  if(!deck.length){
    termEl.textContent=deckView==="active"?"Deck complete!":"No cards in this view.";
    definitionEl.textContent=deckView==="active"?"You have mastered every aerosol-delivery term.":"Choose another tab to continue reviewing.";
    definitionEl.hidden=false;termEl.hidden=false;cardFlipped=true;
    document.getElementById("masterCard").disabled=true;document.getElementById("reviewCard").disabled=true;renderCompletedList();return;
  }
  deckIndex=(deckIndex+deck.length)%deck.length;const item=deck[deckIndex];
  termEl.textContent=item.card.term;definitionEl.textContent=item.card.definition;definitionEl.hidden=true;termEl.hidden=false;cardFlipped=false;
  document.getElementById("masterCard").disabled=deckView==="completed";document.getElementById("reviewCard").disabled=deckView==="active";renderCompletedList();
}
function flipMasteryCard(){if(!currentDeck().length)return;cardFlipped=!cardFlipped;termEl.hidden=cardFlipped;definitionEl.hidden=!cardFlipped}
function moveCard(step){const deck=currentDeck();if(!deck.length)return;deckIndex=(deckIndex+step+deck.length)%deck.length;renderMasteryCard()}
cardEl.addEventListener("click",flipMasteryCard);
cardEl.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();flipMasteryCard()}});
document.getElementById("flipCard").addEventListener("click",flipMasteryCard);
document.getElementById("prevCard").addEventListener("click",()=>moveCard(-1));
document.getElementById("nextCard").addEventListener("click",()=>moveCard(1));
document.getElementById("masterCard").addEventListener("click",()=>{const deck=currentDeck();if(!deck.length)return;masteredCards.add(deck[deckIndex].index);deckIndex=0;updateMasteryProgress();renderMasteryCard()});
document.getElementById("reviewCard").addEventListener("click",()=>{const deck=currentDeck();if(!deck.length)return;masteredCards.delete(deck[deckIndex].index);deckIndex=0;updateMasteryProgress();renderMasteryCard()});
document.querySelectorAll(".tab-btn").forEach(button=>button.addEventListener("click",()=>{
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));button.classList.add("active");deckView=button.dataset.view;deckIndex=0;renderMasteryCard();
}));
updateMasteryProgress();renderMasteryCard();

(function(){
  let built=false;
  function setup(){
    const button=document.getElementById("courseMenuButton"),panel=document.getElementById("courseMenuPanel");
    if(!button||!panel)return;
    button.addEventListener("click",e=>{e.stopPropagation();const open=panel.classList.toggle("open");button.setAttribute("aria-expanded",String(open))});
    document.addEventListener("click",e=>{if(!button.contains(e.target)&&!panel.contains(e.target)){panel.classList.remove("open");button.setAttribute("aria-expanded","false")}});
  }
  function build(){
    if(built)return;const courses=window.PULMOCORE_COURSES||window.pulmoCoreCourses||window.courses||[];
    if(!courses.length)return;built=true;
    const list=document.getElementById("courseMenuList");
    list.innerHTML=courses.map(c=>`<a class="course-menu-item" href="${c.file||c.href||'#'}" role="menuitem"><span class="course-menu-title">${c.title||c.name||'Course'}</span><span class="course-menu-status">Open</span></a>`).join("");
  }
  document.addEventListener("DOMContentLoaded",()=>{setup();build()});window.addEventListener("load",build);setTimeout(build,300);
})();
</script>

