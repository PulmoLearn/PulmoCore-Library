<script>
function markActivityComplete(element){
  if(!element || element.dataset.complete==="true") return;
  element.dataset.complete="true";
  element.dispatchEvent(new CustomEvent("activityComplete",{bubbles:true}));
}
function initializeProgressiveSections(){
  if(initializeProgressiveSections._done)return;
  initializeProgressiveSections._done=true;
  const sections=Array.from(document.querySelectorAll(".lesson-stack-top > section, .lesson-stack > section"));
  const navLinks=Array.from(document.querySelectorAll(".side-nav a[href^='#']"));
  sections.forEach((section,index)=>{section.dataset.sectionIndex=index;if(index>0)section.classList.add("lesson-hidden")});
  function isComplete(section){
    const req=Array.from(section.querySelectorAll(".require-complete"));
    if(section.classList.contains("require-complete")) req.push(section);
    return req.every(x=>x.dataset.complete==="true");
  }
  function update(){
    sections.forEach(section=>{
      const btn=section.querySelector(":scope > .section-continue button");
      if(!btn)return;
      const required=section.classList.contains("require-complete")||section.querySelector(".require-complete");
      btn.disabled=required&&!isComplete(section);
      btn.textContent=btn.disabled?"Complete activity to continue":btn.dataset.readyText;
    });
  }
  function updateNav(current){
    navLinks.forEach(link=>{
      const target=document.querySelector(link.getAttribute("href"));
      const visible=target&&!target.classList.contains("lesson-hidden");
      link.classList.toggle("locked",!visible);
      link.classList.toggle("current",target&&Number(target.dataset.sectionIndex)===current);
    });
  }
  sections.forEach((section,index)=>{
    if(index===sections.length-1)return;
    const next=sections[index+1],heading=next.querySelector("h2,h3");
    const title=heading?heading.textContent.trim():"Next Section";
    const wrap=document.createElement("div");wrap.className="section-continue";
    wrap.innerHTML=`<button class="btn btn-primary" type="button" data-ready-text="Continue to ${title} →">Continue to ${title} →</button>`;
    wrap.querySelector("button").addEventListener("click",()=>{
      if(wrap.querySelector("button").disabled)return;
      next.classList.remove("lesson-hidden");updateNav(index+1);update();wrap.remove();
      next.scrollIntoView({behavior:"smooth",block:"start"});
    });
    section.appendChild(wrap);
  });
  navLinks.forEach(link=>link.addEventListener("click",e=>{
    const target=document.querySelector(link.getAttribute("href"));
    if(!target||target.classList.contains("lesson-hidden")){e.preventDefault();return;}
    updateNav(Number(target.dataset.sectionIndex));
  }));
  document.addEventListener("activityComplete",update);updateNav(0);update();
}
initializeProgressiveSections();

function initializeSingleCheck(activityId,statusId){
  const activity=document.querySelector(`[data-activity-id="${activityId}"]`);
  if(!activity)return;
  activity.querySelectorAll(".single-check-option").forEach(btn=>btn.addEventListener("click",()=>{
    if(activity.dataset.complete==="true")return;
    const feedback=activity.querySelector(".quiz-feedback");
    activity.querySelectorAll(".single-check-option").forEach(b=>b.classList.remove("incorrect-choice"));
    if(btn.dataset.correct==="true"){
      btn.classList.add("correct-choice");activity.querySelectorAll(".single-check-option").forEach(b=>b.disabled=true);
      feedback.className="quiz-feedback show";feedback.style.background="var(--airway-mint)";
      feedback.innerHTML=btn.dataset.feedback+"<br><br><strong>Correct answer locked in.</strong>";
      const status=document.getElementById(statusId);status.textContent="Activity complete.";status.classList.add("complete");
      markActivityComplete(activity);
    }else{
      btn.classList.add("incorrect-choice");feedback.className="quiz-feedback show";feedback.style.background="var(--soft-coral)";
      feedback.innerHTML=btn.dataset.feedback+"<br><br><strong>Try again.</strong>";
    }
  }));
}
initializeSingleCheck("pharm_1_4_breathing_pattern","breathingStatus");
initializeSingleCheck("pharm_1_4_spacer_check","spacerStatus");
initializeSingleCheck("pharm_1_4_device_selection","deviceStatus");
initializeSingleCheck("pharm_1_4_dpi_check","dpiStatus");

function initSort(buttonId,statusId,activityId){
  const button=document.getElementById(buttonId),status=document.getElementById(statusId);
  const activity=document.querySelector(`[data-activity-id="${activityId}"]`);
  button.addEventListener("click",()=>{
    const rows=Array.from(activity.querySelectorAll(".sort-row"));let correct=0;
    rows.forEach(row=>{
      const ok=row.querySelector("select").value===row.dataset.answer;
      row.classList.toggle("correct",ok);row.classList.toggle("incorrect",!ok);if(ok)correct++;
