<body>
<div class="topbar"><div class="topbar-inner"><div class="brand"><img class="brand-logo" alt="PulmoQuest logo" src="data:image/png;base64,"><div><div class="brand-name"><span class="pulmo">Pulmo</span><span class="quest">Quest</span></div><div class="brand-tagline">Interactive respiratory therapy education.</div></div></div><div class="stats"><div class="pill" id="xpPill">XP 0</div><div class="pill" id="starPill">☆☆☆</div><div class="pill" id="badgePill">Badge locked</div></div></div></div>
<div class="layout"><aside class="side"><div class="level-card"><div class="eyebrow">Level 5</div><h2>Respiratory Care ABG Master</h2><p>Interpret full patient stories, serial ABGs, oxygen response, ventilator changes, and clinical priorities.</p><div class="progress-track"><div class="progress-fill" id="progressFill" style="width:0%"></div></div><div class="meta-row"><span>Level progress</span><span id="progressText">0%</span></div></div><div class="phase-list" id="phaseList"></div><div class="badge-box"><div class="badge-medal" id="badgeMedal">🏆</div><strong>ABG Master</strong><p id="badgeText" style="margin:4px 0 0;color:var(--muted);font-size:.82rem">Complete the final challenge.</p></div></aside><main><section class="hero"><div class="hero-card"><div class="eyebrow" id="stepCount">Final level</div><h1 id="heroTitle">Respiratory Care ABG Master</h1><p id="heroSub">This level brings together ABG interpretation, validation, oxygenation, trends, and RT decision-making.</p></div></section><section class="screen" id="screen"><div class="content"><h2>Loading Level 5...</h2><p>If this remains, reload the page or reset progress.</p></div></section></main></div>
<script>
const STORAGE='pulmoquest_abg_level5_v1';
const SHARED='pulmoquest_abg_progress';
const DASHBOARD_URL='index.html';
const defaultState={step:0,answered:{},xp:0,bestScore:0,bestStars:0,lastScore:0,lastStars:0,badge:false,challengeDone:false,lastSkillResults:{}};
let state=load();let challenge={active:false,index:0,cases:[],answers:[]};
const screen=document.getElementById('screen'), heroTitle=document.getElementById('heroTitle'), heroSub=document.getElementById('heroSub'), stepCount=document.getElementById('stepCount');
function load(){try{return Object.assign({},defaultState,JSON.parse(localStorage.getItem(STORAGE)||'{}'))}catch(e){return {...defaultState,answered:{}}}}
function save(){try{localStorage.setItem(STORAGE,JSON.stringify(state));const shared=JSON.parse(localStorage.getItem(SHARED)||'{}');shared.level5={completed:state.bestStars>=1,bestStars:state.bestStars,bestScore:state.bestScore,badge:state.badge};localStorage.setItem(SHARED,JSON.stringify(shared))}catch(e){}}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function setHTML(html,needs=false,nextLabel='Next'){screen.innerHTML=`<div class="content">${html}</div><div class="footer"><button class="btn ghost" onclick="prevStep()" ${state.step===0?'disabled':''}>Back</button><span class="lock-note">${needs&&!state.answered[state.step]?'Answer required to continue.':'Progress saved automatically.'}</span><button class="btn primary" id="nextBtn" onclick="nextStep()" ${needs&&!state.answered[state.step]?'disabled':''}>${nextLabel}</button></div>`;updateChrome();window.scrollTo({top:0,behavior:'smooth'})}
function ask(q,opts,correct,good,bad){const body=`<div class="quiz"><div class="question">${q}</div><div class="options">${opts.map((o,i)=>`<button type="button" class="option" data-i="${i}" onclick="answerLesson(${i})">${esc(o)}</button>`).join('')}</div><div id="fb" class="feedback"></div></div>`;return body}
let currentCorrect=0,currentGood='',currentBad='';
function lessonQuestion(q,opts,correct,good,bad){currentCorrect=correct;currentGood=good;currentBad=bad;return ask(q,opts,correct,good,bad)}
function answerLesson(i){const opts=[...document.querySelectorAll('.option')];opts.forEach(b=>b.disabled=true);const fb=document.getElementById('fb');if(i===currentCorrect){opts[i].classList.add('correct');fb.className='feedback good show';fb.textContent=currentGood;state.answered[state.step]=true;state.xp+=10;save();document.getElementById('nextBtn').disabled=false;document.querySelector('.lock-note').textContent='Correct. Continue when ready.'}else{opts[i].classList.add('incorrect');opts[currentCorrect].classList.add('correct');fb.className='feedback bad show';fb.textContent=currentBad;setTimeout(()=>{opts.forEach(b=>{b.disabled=false;b.classList.remove('incorrect','correct')});fb.className='feedback';fb.textContent=''},1900)}}
function abg(c){return `<div class="abg"><div class="abg-head"><span>${esc(c.title||'ABG result')}</span><span>${esc(c.note||'')}</span></div><div class="abg-grid"><div class="abg-cell"><span>pH</span><strong>${Number(c.ph).toFixed(2)}</strong></div><div class="abg-cell"><span>PaCO₂</span><strong>${c.co2}</strong></div><div class="abg-cell"><span>HCO₃⁻</span><strong>${c.hco3}</strong></div><div class="abg-cell"><span>PaO₂</span><strong>${c.o2}</strong></div></div></div>`}
function patient(items){return `<div class="patient">${items.map(([k,v])=>`<div><b>${esc(k)}</b><br><span>${esc(v)}</span></div>`).join('')}</div>`}
const phases=['Shift Briefing','Serial ABGs','Clinical Priority','Ventilator Context','Gas Exchange','Readiness','Master Challenge'];
const steps=[
 {phase:0,title:'Final Shift Briefing',sub:'Bring every ABG skill together.',render(){setHTML(`<h2>Respiratory Care ABG Master</h2><p class="lead">In this final level, the ABG is no longer just a set of numbers. You will decide whether the result fits the patient, whether the patient is improving or worsening, and what the respiratory therapist should prioritize next.</p><div class="flow"><div><b>Interpret</b><span>Identify acid-base and oxygenation findings.</span></div><div><b>Validate</b><span>Check sample quality, timing, and clinical agreement.</span></div><div><b>Act</b><span>Choose the safest respiratory care priority.</span></div></div><div class="note">The goal is not to memorize one label. The goal is to report a defensible interpretation and connect it to patient care.</div>`,false)}},
 {phase:0,title:'Final Interpretation',sub:'Technical classification is only the beginning.',render(){setHTML(`<h2>From technical classification to final interpretation</h2><p>A technical classification tells you the acid-base pattern. A final interpretation also considers timing, expected compensation, oxygenation, specimen reliability, and the patient story.</p><table class="mini-table"><tr><th>Technical classification</th><th>Final interpretation</th></tr><tr><td>Metabolic acidosis</td><td>Metabolic acidosis with appropriate respiratory compensation and moderate hypoxemia.</td></tr><tr><td>Respiratory acidosis</td><td>Acute-on-chronic respiratory acidosis after ventilatory failure, with worsening oxygenation.</td></tr></table>${lessonQuestion('Which answer best describes a final interpretation?', ['Only the pH category','The complete acid-base disorder plus oxygenation, validity, and clinical meaning','The oxygen device alone','The patient diagnosis without using the ABG'],1,'Correct. The final interpretation connects the numbers to oxygenation, validity, and patient care.','A final interpretation goes beyond the pH label and connects the result to the patient.')}`,true)}},
 {phase:1,title:'Serial ABGs',sub:'Use trends to decide whether the patient is improving.',render(){setHTML(`<h2>Serial ABGs: trend before you react</h2><p>One ABG is a snapshot. Serial ABGs show direction. When values are changing, ask whether ventilation, oxygenation, and pH are improving or deteriorating.</p>${patient([['Patient','COPD exacerbation on BiPAP'],['Trend','ABG repeated after bronchodilators and noninvasive ventilation'],['Clinical clue','Work of breathing is decreasing']])}<table class="mini-table"><tr><th>Time</th><th>pH</th><th>PaCO₂</th><th>HCO₃⁻</th><th>PaO₂</th></tr><tr><td>08:00</td><td>7.24</td><td>72</td><td>31</td><td>58</td></tr><tr><td>10:00</td><td>7.31</td><td>62</td><td>31</td><td>70</td></tr></table>${lessonQuestion('What is the best trend statement?', ['The patient is worsening because PaCO₂ is still high','Ventilation and oxygenation are improving, but the patient still has respiratory acidosis','The ABG is normal now','This must be metabolic acidosis'],1,'Correct. The patient is not normal, but the trend is improving.','Focus on direction: pH is rising, PaCO₂ is falling, and PaO₂ is improving.')}`,true)}},
 {phase:1,title:'Acute-on-Chronic Pattern',sub:'Recognize baseline compensation with acute deterioration.',render(){setHTML(`<h2>Acute-on-chronic respiratory acidosis</h2><p>A patient with chronic CO₂ retention may have an elevated HCO₃⁻ at baseline. If PaCO₂ rises further and pH drops, an acute problem may be added on top of the chronic disorder.</p>${abg({title:'COPD patient',note:'Drowsy after opioid pain medication',ph:7.22,co2:86,hco3:34,o2:61})}<div class="note">The HCO₃⁻ is elevated, suggesting chronic renal compensation. The pH is still severely acidotic because ventilation has acutely worsened.</div>${lessonQuestion('What is the best interpretation?', ['Fully compensated respiratory acidosis','Acute-on-chronic respiratory acidosis with mild hypoxemia','Metabolic alkalosis with normal oxygenation','Respiratory alkalosis'],1,'Correct. Chronic compensation is present, but the low pH shows an acute worsening.','The elevated bicarbonate does not make this fully compensated because the pH is still acidotic.')}`,true)}},
 {phase:2,title:'Clinical Priority',sub:'ABGs support patient care, but assessment comes first.',render(){setHTML(`<h2>Do not wait for perfect numbers in an unstable patient</h2><p>ABGs are objective data, but the patient comes first. Severe distress, apnea, declining mental status, or shock should trigger stabilization while ABG interpretation continues.</p>${patient([['Patient','Post-op patient found somnolent'],['Vitals','RR 6/min, SpO₂ 84% on 2 L/min'],['Assessment','Shallow respirations, difficult to arouse']])}${abg({title:'ABG',note:'Opioid overdose suspected',ph:7.18,co2:78,hco3:28,o2:50})}${lessonQuestion('What should the RT prioritize?', ['Calculate anion gap first','Support ventilation and oxygenation immediately while notifying the team','Wait for a repeat ABG before intervening','Decrease oxygen because PaCO₂ is high'],1,'Correct. This is ventilatory failure with hypoxemia and altered mental status. Stabilization comes first.','This patient is unstable. ABG interpretation should support immediate ventilation and oxygenation.')}`,true)}},
 {phase:2,title:'DKA Integration',sub:'Appropriate compensation can be clinically expected.',render(){setHTML(`<h2>Metabolic acidosis with respiratory compensation</h2><p>In metabolic acidosis, the lungs try to lower PaCO₂ by increasing ventilation. The respiratory response can be appropriate, but it does not fully normalize the pH.</p>${patient([['Patient','DKA, deep rapid respirations'],['Clinical clue','Kussmaul breathing'],['Glucose/ketones','High glucose, positive ketones']])}${abg({title:'DKA ABG',note:'Expected hyperventilation',ph:7.18,co2:22,hco3:8,o2:94})}${lessonQuestion('What is the best interpretation?', ['Metabolic acidosis with appropriate respiratory compensation and normal oxygenation','Respiratory alkalosis because PaCO₂ is low','Fully compensated metabolic acidosis with normal pH','Metabolic alkalosis with hypoxemia'],0,'Correct. The low PaCO₂ is the expected respiratory response to metabolic acidosis.','The low PaCO₂ is not the primary disorder here; it is the respiratory response to low bicarbonate.')}`,true)}},
 {phase:3,title:'Ventilator Timing',sub:'Account for recent setting changes.',render(){setHTML(`<h2>Ventilator changes need time to equilibrate</h2><p>When ventilator settings change, a blood gas drawn too soon may not reflect the final response. Always check when the setting changed and when the ABG was drawn.</p>${patient([['Patient','Intubated asthma exacerbation'],['Change','Respiratory rate increased from 12 to 18/min'],['ABG timing','Sample drawn 2 minutes after change']])}${abg({title:'Post-change ABG',note:'Drawn too soon',ph:7.24,co2:62,hco3:26,o2:88})}${lessonQuestion('What is the best response?', ['Declare the ventilator change failed immediately','Interpret cautiously because the sample was drawn too soon after the ventilator change','Ignore the PaCO₂ because the PaO₂ is normal','Call it metabolic acidosis'],1,'Correct. The timing matters. The result may not reflect the full effect of the ventilator change.','A sample drawn immediately after a ventilator adjustment may be misleading.')}`,true)}},
 {phase:3,title:'Oxygen Response',sub:'Use FiO₂ context instead of PaO₂ alone.',render(){setHTML(`<h2>PaO₂ must be interpreted with FiO₂</h2><p>A PaO₂ of 80 can be normal on room air but concerning on high FiO₂. Use the P/F ratio or expected PaO₂ response to judge gas exchange.</p>${patient([['Patient','ARDS on mechanical ventilation'],['FiO₂','0.80'],['PEEP','12 cmH₂O']])}${abg({title:'ARDS ABG',note:'High oxygen requirement',ph:7.36,co2:42,hco3:24,o2:80})}<div class="note">P/F ratio = 80 / 0.80 = 100. This reflects severe gas-exchange impairment even though the PaO₂ number alone may look less dramatic.</div>${lessonQuestion('What is the best gas-exchange conclusion?', ['Normal oxygenation because PaO₂ is 80','Severe gas-exchange impairment because PaO₂ is only 80 on 80% FiO₂','Respiratory alkalosis','The sample must be venous'],1,'Correct. The oxygen level is not appropriate for the high FiO₂.','Always interpret PaO₂ with the oxygen setting.')}`,true)}},
 {phase:4,title:'Mixed Disorder Integration',sub:'A second primary problem can hide inside “normal” values.',render(){setHTML(`<h2>Mixed disorders require expected-value thinking</h2><p>When the secondary value is not where it should be, look for another primary disorder rather than calling it overcompensation.</p>${patient([['Patient','Sepsis with worsening fatigue'],['Labs','Lactate elevated'],['Assessment','Increasing work of breathing, now tiring']])}${abg({title:'Sepsis ABG',note:'Expected PaCO₂ should be low',ph:7.12,co2:42,hco3:13,o2:82})}<div class="note">For HCO₃⁻ 13, PaCO₂ should be much lower if respiratory compensation is appropriate. A PaCO₂ of 42 adds respiratory acidosis.</div>${lessonQuestion('What is the best final interpretation?', ['Uncompensated metabolic acidosis only','Mixed metabolic acidosis and respiratory acidosis','Respiratory alkalosis with normal oxygenation','Normal acid-base status'],1,'Correct. The respiratory system is not compensating; it is adding a second acid-base problem.','A normal PaCO₂ is not appropriate when the bicarbonate is this low.')}`,true)}},
 {phase:4,title:'Specimen and Story Check',sub:'A result must make clinical sense.',render(){setHTML(`<h2>Validate the result against the patient</h2><p>If the ABG does not match the patient assessment, pulse oximetry, oxygen setting, or collection details, pause before reporting it as fact.</p>${patient([['Patient','Awake, talking in full sentences'],['Pulse ox','SpO₂ 98% with good waveform on room air'],['Collection note','Difficult draw, blood appeared dark']])}${abg({title:'Questionable sample',note:'Possible venous draw',ph:7.38,co2:45,hco3:25,o2:35})}${lessonQuestion('What is the safest response?', ['Report severe arterial hypoxemia without question','Question possible venous sample and verify or recollect','Ignore pulse oximetry completely','Increase FiO₂ to 100% before reassessing'],1,'Correct. The PaO₂ does not match the patient or SpO₂, so sample validity should be questioned.','This pattern strongly suggests the ABG may not represent arterial oxygenation.')}`,true)}},
 {phase:5,title:'Readiness Case',sub:'Put it together before the final challenge.',render(){setHTML(`<h2>Readiness case</h2>${patient([['Patient','Pulmonary embolism suspected'],['Symptoms','Sudden dyspnea and pleuritic chest pain'],['Oxygen','Room air, SpO₂ 90%']])}${abg({title:'Readiness ABG',note:'Clinical integration',ph:7.49,co2:29,hco3:22,o2:62})}${lessonQuestion('Which statement best integrates the ABG and patient story?', ['Respiratory alkalosis with mild hypoxemia; clinical story suggests V/Q mismatch should be assessed','Metabolic alkalosis with normal oxygenation','Normal ABG; no further evaluation needed','Specimen must be rejected because PaCO₂ is low'],0,'Correct. Hyperventilation plus hypoxemia fits a V/Q mismatch pattern such as PE.','The ABG shows alkalosis from low PaCO₂ and mild hypoxemia; connect it to the clinical picture.')}`,true)}},
 {phase:5,title:'Master Challenge Unlocked',sub:'Final ABG shift.',render(){setHTML(`<h2>ABG Master Challenge unlocked</h2><p class="lead">You will receive eight clinical ABG encounters. Choose the best interpretation, validation decision, or RT priority.</p><div class="flow"><div><b>8 encounters</b><span>Serial trends, mixed disorders, ventilator timing, oxygenation, specimen checks</span></div><div><b>Stars</b><span>Best result is retained for your final badge.</span></div><div><b>Master badge</b><span>Earn at least one star. Retry for mastery.</span></div></div>`,false,'Begin Challenge')}},
 {phase:6,title:'Challenge',sub:'',render(){startChallenge()}}
];
const pool=[
 {skill:'serial trends',type:'Serial ABG',ph:7.31,co2:62,hco3:31,o2:70,context:'COPD exacerbation improved from pH 7.24, PaCO₂ 72, PaO₂ 58 after BiPAP.',answer:'Improving acute-on-chronic respiratory acidosis with mild hypoxemia; continue close monitoring.'},
 {skill:'clinical priority',type:'Clinical priority',ph:7.18,co2:78,hco3:28,o2:50,context:'Post-op patient is somnolent with RR 6/min after opioids.',answer:'Ventilatory failure: support ventilation and oxygenation immediately and notify the team.'},
 {skill:'mixed/complex interpretation',type:'Mixed disorder',ph:7.12,co2:42,hco3:13,o2:82,context:'Sepsis with elevated lactate; expected PaCO₂ should be much lower.',answer:'Mixed metabolic acidosis and respiratory acidosis with normal oxygenation.'},
 {skill:'oxygenation/gas exchange',type:'Gas exchange',ph:7.36,co2:42,hco3:24,o2:80,context:'ARDS patient on FiO₂ 0.80; P/F ratio is 100.',answer:'Severe gas-exchange impairment despite PaO₂ 80 because FiO₂ requirement is high.'},
 {skill:'specimen/context validation',type:'Specimen validity',ph:7.38,co2:45,hco3:25,o2:35,context:'Room air SpO₂ 98% with good waveform; difficult draw and dark blood.',answer:'Question possible venous sample and recollect or verify before accepting PaO₂.'},
 {skill:'ventilator/oxygen response',type:'Ventilator timing',ph:7.24,co2:62,hco3:26,o2:88,context:'ABG drawn 2 minutes after increasing ventilator respiratory rate.',answer:'Interpret cautiously; sample was drawn too soon to judge the ventilator change.'},
 {skill:'clinical priority',type:'DKA response',ph:7.18,co2:22,hco3:8,o2:94,context:'DKA with deep rapid Kussmaul respirations.',answer:'Metabolic acidosis with appropriate respiratory compensation and normal oxygenation.'},
 {skill:'oxygenation/gas exchange',type:'PE pattern',ph:7.49,co2:29,hco3:22,o2:62,context:'Sudden dyspnea, chest pain, room air SpO₂ 90%.',answer:'Respiratory alkalosis with mild hypoxemia; evaluate for V/Q mismatch such as PE.'},
 {skill:'ventilator/oxygen response',type:'Oxygen response',ph:7.35,co2:44,hco3:24,o2:58,context:'PaO₂ rose only from 55 to 58 after FiO₂ increased from 0.40 to 0.60.',answer:'Poor oxygen response suggests refractory hypoxemia or significant shunt physiology.'},
 {skill:'specimen/context validation',type:'Air contamination',ph:7.52,co2:28,hco3:23,o2:132,context:'Visible air bubble remained in syringe before analysis.',answer:'Question air contamination and recollect before making a final interpretation.'}
];
const skills=['serial trends','clinical priority','mixed/complex interpretation','oxygenation/gas exchange','specimen/context validation','ventilator/oxygen response'];
function pickCases(){let cases=[];skills.forEach(skill=>{let arr=pool.filter(c=>c.skill===skill);cases.push(arr[Math.floor(Math.random()*arr.length)])});let extra=pool.filter(c=>!cases.includes(c)).sort(()=>Math.random()-.5).slice(0,2);return cases.concat(extra).sort(()=>Math.random()-.5)}
function choices(c){const all=[...new Set(pool.map(x=>x.answer))];return [c.answer,...all.filter(x=>x!==c.answer).sort(()=>Math.random()-.5).slice(0,3)].sort(()=>Math.random()-.5)}
function render(){if(challenge.active){renderChallengeCase();return}const s=steps[state.step];heroTitle.textContent=s.title;heroSub.textContent=s.sub;stepCount.textContent=`Step ${Math.min(state.step+1,steps.length)} of ${steps.length}`;s.render();}
function nextStep(){if(state.step<steps.length-1){state.step++;save();render()}}
function prevStep(){if(state.step>0){state.step--;save();render()}}
function updateChrome(){const pct=Math.round((state.step)/(steps.length-1)*100);document.getElementById('progressFill').style.width=pct+'%';document.getElementById('progressText').textContent=pct+'%';document.getElementById('xpPill').textContent='XP '+state.xp;document.getElementById('starPill').textContent='★'.repeat(state.bestStars)+'☆'.repeat(3-state.bestStars);document.getElementById('badgePill').textContent=state.badge?'Badge earned':'Badge locked';document.getElementById('badgeText').textContent=state.badge?'Respiratory Care ABG Master earned':'Complete the final challenge.';document.getElementById('badgeMedal').classList.toggle('gold',state.bestStars>=3);document.getElementById('phaseList').innerHTML=phases.map((p,i)=>`<div class="phase ${i===(steps[state.step]?.phase||0)?'active':''}">${p}</div>`).join('')}
function startChallenge(){challenge={active:true,index:0,cases:pickCases(),answers:[]};renderChallengeCase()}
function renderChallengeCase(){const c=challenge.cases[challenge.index];heroTitle.textContent='ABG Master Challenge';heroSub.textContent='Choose the best interpretation, validation decision, or RT priority.';stepCount.textContent=`Case ${challenge.index+1} of ${challenge.cases.length}`;screen.innerHTML=`<div class="content"><div class="challenge-progress">${challenge.cases.map((_,i)=>`<div class="bar ${i<challenge.index?'done':i===challenge.index?'current':''}"></div>`).join('')}</div>${abg({title:c.type,note:'Level 5 final challenge',ph:c.ph,co2:c.co2,hco3:c.hco3,o2:c.o2})}<div class="note">${esc(c.context)}</div><div class="quiz"><div class="question">Choose the best response.</div><div class="options">${choices(c).map((o,i)=>`<button type="button" class="option" data-answer="${esc(o)}" onclick="answerChallengeFromButton(this)">${esc(o)}</button>`).join('')}</div></div></div><div class="footer"><button class="btn ghost" onclick="exitChallenge()">Exit challenge</button><span class="lock-note">Choose one answer.</span><button class="btn primary" disabled>Next case</button></div>`;updateChrome();window.scrollTo({top:0,behavior:'smooth'})}
function answerChallengeFromButton(btn){answerChallenge(btn.getAttribute('data-answer'))}
function answerChallenge(ans){const c=challenge.cases[challenge.index];challenge.answers.push({skill:c.skill,ok:ans===c.answer});challenge.index++;if(challenge.index>=challenge.cases.length)finishChallenge();else renderChallengeCase()}
function exitChallenge(){challenge={active:false,index:0,cases:[],answers:[]};state.step=steps.length-2;save();render()}
function finishChallenge(){const correct=challenge.answers.filter(a=>a.ok).length;const score=Math.round(correct/challenge.answers.length*100);const stars=score>=95?3:score>=85?2:score>=70?1:0;let results={};skills.forEach(skill=>{const items=challenge.answers.filter(a=>a.skill===skill);const n=items.filter(a=>a.ok).length;results[skill]={correct:n,total:items.length||1,passed:items.length>0&&n===items.length}});state.lastScore=score;state.lastStars=stars;state.lastSkillResults=results;state.bestScore=Math.max(state.bestScore,score);state.bestStars=Math.max(state.bestStars,stars);state.badge=state.bestStars>=1;state.challengeDone=true;state.xp+=score;save();renderResults()}
function renderResults(){heroTitle.textContent='Final Challenge Results';heroSub.textContent='Review missed competencies and improve your final mastery stars.';stepCount.textContent='Level 5 results';const rows=skills.map(skill=>{const r=state.lastSkillResults[skill]||{correct:0,total:1,passed:false};const label=skill.replace(/\w/g,m=>m.toUpperCase());return r.passed?`<div class="skill"><span>${label}</span><span class="good">Demonstrated (${r.correct}/${r.total})</span></div>`:`<div class="skill"><span>${label}</span><span class="needs">${r.correct?'Developing':'Needs review'} (${r.correct}/${r.total})</span><button class="review-btn" onclick="reviewSkill('${skill}')">Review</button></div>`}).join('');screen.innerHTML=`<div class="content results"><div class="stars">${'★'.repeat(state.lastStars)}${'☆'.repeat(3-state.lastStars)}</div><h2>${state.lastStars?'Respiratory Care ABG Master Challenge complete':'Review recommended'}</h2><p>Latest score: <strong>${state.lastScore}%</strong>${state.bestScore>state.lastScore?` &nbsp;•&nbsp; Best score: <strong>${state.bestScore}%</strong>`:''}</p>${state.badge?'<div class="sentence">Badge earned: Respiratory Care ABG Master</div>':'<p>Earn at least 70% to unlock the final badge.</p>'}<div class="skill-list">${rows}</div></div><div class="footer"><button class="btn ghost" onclick="resetLevel()">Reset Level</button><span class="lock-note">${state.bestStars>=2?'Final mastery demonstrated. Retry for three stars if desired.':'Earn at least two stars to mark final mastery.'}</span><div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end"><button class="btn ghost" onclick="startChallenge()">Retry Challenge</button>${state.bestStars>=2?'<button class="btn primary" onclick="goToDashboard()">Return to Mastery Center</button>':''}</div></div>`;updateChrome();window.scrollTo({top:0,behavior:'smooth'})}
function reviewSkill(skill){const html={
 'serial trends':`<h2>Review: Serial trends</h2><p>Compare the current ABG with the previous ABG. Ask: Is pH moving toward normal? Is PaCO₂ improving? Is PaO₂ improving? The patient may still be abnormal but trending better.</p><div class="note">Improving does not mean normal. It means the direction supports the current intervention.</div>`,
 'clinical priority':`<h2>Review: Clinical priority</h2><p>When the patient is unstable, stabilize first. Severe hypoxemia, apnea, altered mental status, or shock should trigger immediate respiratory support while interpretation continues.</p><div class="danger note">Do not delay ventilation or oxygenation support to finish calculations.</div>`,
 'mixed/complex interpretation':`<h2>Review: Mixed or complex disorders</h2><p>Use expected compensation. If the secondary value is not where it should be, consider a second primary disorder rather than calling it overcompensation.</p>`,
 'oxygenation/gas exchange':`<h2>Review: Oxygenation and gas exchange</h2><p>PaO₂ must be interpreted with FiO₂. A PaO₂ of 80 on room air is very different from a PaO₂ of 80 on 80% FiO₂.</p><div class="note">P/F ratio = PaO₂ ÷ FiO₂ as a decimal.</div>`,
 'specimen/context validation':`<h2>Review: Specimen and context validation</h2><p>Question results that do not match the patient, pulse ox, oxygen device, or collection notes. Possible venous samples, air bubbles, clots, and timing problems should be verified.</p>`,
 'ventilator/oxygen response':`<h2>Review: Ventilator and oxygen response</h2><p>Check when the oxygen or ventilator setting changed. ABGs drawn immediately after a change may not show the full response. Poor PaO₂ response to increased FiO₂ suggests significant shunt or refractory hypoxemia.</p>`
}[skill];heroTitle.textContent='Targeted Review';heroSub.textContent=skill.replace(/\w/g,m=>m.toUpperCase());stepCount.textContent='Review';screen.innerHTML=`<div class="content">${html}</div><div class="footer"><button class="btn ghost" onclick="renderResults()">Back to Results</button><span class="lock-note">Review complete when ready.</span><button class="btn primary" onclick="startChallenge()">Retry Challenge</button></div>`;updateChrome();window.scrollTo({top:0,behavior:'smooth'})}
function goToDashboard(){window.location.href=DASHBOARD_URL}
function resetLevel(){if(confirm('Reset all Level 5 progress?')){localStorage.removeItem(STORAGE);state={...defaultState,answered:{}};challenge={active:false,index:0,cases:[],answers:[]};render()}}
function boot(){try{render()}catch(e){screen.innerHTML='<div class="content"><h2>Level 5 could not load.</h2><p>'+esc(e.message)+'</p><button class="btn ghost" onclick="resetLevel()">Reset Level</button></div>';console.error(e)}}
boot();setTimeout(()=>{if(screen.textContent.includes('Loading Level 5'))boot()},100);
</script>
</body>
