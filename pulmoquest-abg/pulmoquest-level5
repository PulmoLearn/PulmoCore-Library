<style>
:root{--navy:#0B1F33;--navy2:#143653;--teal:#1CA7A8;--blue:#4BA3F2;--ink:#173044;--muted:#60758a;--line:#d6e5ee;--ok:#27875d;--warn:#b87514;--danger:#b63b3b;--gold:#f0b43c;--shadow:0 16px 36px rgba(11,31,51,.12)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:linear-gradient(180deg,#f5fbff,#edf8f7);color:var(--ink);min-height:100vh}button{font:inherit;cursor:pointer}.topbar{position:sticky;top:0;z-index:30;background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;padding:12px 20px;box-shadow:0 8px 24px rgba(11,31,51,.22)}.topbar-inner{max-width:1080px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:13px}.brand-logo{width:58px;height:58px;border-radius:17px;object-fit:cover}.brand-name{margin:0;font-size:1.55rem;line-height:1;font-weight:900;letter-spacing:-.04em}.pulmo{color:#fff}.quest{color:var(--teal)}.brand-tagline{margin:7px 0 0;color:#d6dbe4;font-weight:650;font-size:.78rem}.stats{display:flex;gap:8px;flex-wrap:wrap}.pill{padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.16);font-size:.78rem;font-weight:750}.layout{max-width:1080px;margin:auto;padding:18px;display:grid;grid-template-columns:245px minmax(0,1fr);gap:18px}.side,.hero,.screen{background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.side{padding:15px;height:max-content;position:sticky;top:88px}.level-card{padding:16px;border-radius:18px;background:linear-gradient(145deg,var(--navy),var(--navy2));color:#fff}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.68rem;font-weight:950;color:#8ee0de}.level-card h2{font-size:1.25rem;margin:8px 0}.level-card p{margin:0;color:#d6e4ef;font-size:.86rem;line-height:1.35}.progress-track{height:8px;background:rgba(255,255,255,.16);border-radius:999px;margin:14px 0 7px;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));border-radius:999px;transition:.25s}.meta-row{display:flex;justify-content:space-between;gap:12px;font-size:.8rem;color:#d6e4ef}.phase-list{display:grid;gap:8px;margin-top:14px}.phase{padding:10px;border-radius:13px;background:#f6fafc;border:1px solid var(--line);font-size:.8rem;font-weight:850;color:#456276}.phase.active{border-color:var(--teal);background:#eafaf8;color:#116c6f}.badge-box{margin-top:14px;padding:13px;border-radius:16px;background:#f9fcfd;border:1px solid var(--line);text-align:center}.badge-medal{width:76px;height:76px;border-radius:50%;display:grid;place-items:center;margin:0 auto 8px;background:linear-gradient(135deg,#dbe7ee,#fff);border:4px solid #b6c7d3;color:var(--navy);font-size:1.8rem}.badge-medal.gold{border-color:var(--gold)}.hero{padding:20px;margin-bottom:16px}.hero-card{padding:21px;border-radius:20px;background:linear-gradient(145deg,var(--navy),var(--navy2));color:#fff}.hero h1{margin:7px 0 6px;font-size:1.7rem;letter-spacing:-.04em}.hero p{margin:0;color:#d6e4ef;line-height:1.45}.screen{overflow:hidden}.content{padding:24px}h2,h3{color:var(--navy);margin:0 0 10px;letter-spacing:-.03em}p{line-height:1.52}.lead{font-size:1.02rem;color:#445f74}.note{border-left:4px solid var(--teal);background:#edfafa;border-radius:12px;padding:12px 14px;margin:13px 0;color:#164e58}.warn{border-left-color:var(--warn);background:#fff8ed;color:#7a4b07}.danger{border-left-color:var(--danger);background:#fff0f0;color:#842828}.flow{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:13px 0}.flow>div{border:1px solid var(--line);border-radius:15px;background:#fbfdfe;padding:13px}.flow b{display:block;color:var(--navy);margin-bottom:5px}.flow span{font-size:.86rem;color:var(--muted)}.abg{background:#10283f;color:white;border-radius:16px;padding:15px;margin:13px 0}.abg-head{display:flex;justify-content:space-between;gap:8px;text-transform:uppercase;letter-spacing:.08em;color:#8fdfdc;font-size:.7rem;font-weight:950}.abg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:11px}.abg-cell{text-align:center;background:rgba(255,255,255,.08);border-radius:12px;padding:11px 6px}.abg-cell span{display:block;color:#bed3e2;font-size:.7rem}.abg-cell strong{font-size:1.25rem}.mini-table{width:100%;border-collapse:collapse;margin:12px 0;overflow:hidden;border-radius:14px}.mini-table th,.mini-table td{border:1px solid var(--line);padding:10px;text-align:left}.mini-table th{background:#143653;color:#fff}.quiz{margin-top:14px;padding:15px;border:1px dashed #b9d2df;border-radius:16px;background:#f8fbfc}.question{font-weight:950;color:var(--navy);margin-bottom:11px}.options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.option{border:1px solid var(--line);background:#fff;padding:11px;border-radius:12px;font-weight:850;color:var(--ink);text-align:left}.option:hover{border-color:var(--teal);background:#eefaf8}.option.correct{background:#e8f7ef;border-color:#86cba7;color:#176e47}.option.incorrect{background:#fff0f0;border-color:#e7a0a0;color:#9e3737}.feedback{display:none;margin-top:10px;padding:10px 12px;border-radius:11px;font-size:.88rem}.feedback.show{display:block}.feedback.good{background:#e8f7ef;color:#176e47}.feedback.bad{background:#fff2ef;color:#99433a}.footer{border-top:1px solid var(--line);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fbfdfe}.btn{border:0;border-radius:12px;padding:11px 15px;font-weight:950}.primary{background:linear-gradient(135deg,var(--teal),var(--blue));color:#fff}.ghost{background:#edf3f6;color:var(--navy)}.btn:disabled{opacity:.42;cursor:not-allowed}.lock-note{font-size:.78rem;color:var(--muted)}.stars{font-size:2.1rem;letter-spacing:5px;color:var(--gold)}.results{text-align:center}.skill-list{display:grid;gap:8px;margin-top:14px;text-align:left}.skill{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fbfdfe}.good{color:var(--ok);font-weight:950}.needs{color:var(--warn);font-weight:950}.review-btn{border:0;border-radius:10px;padding:7px 11px;background:#fff0d9;color:#8a5600;font-weight:950}.challenge-progress{display:flex;gap:6px;margin-bottom:12px}.bar{height:7px;flex:1;border-radius:99px;background:#dfe9ee}.bar.current{background:var(--blue)}.bar.done{background:var(--teal)}.sentence{margin-top:11px;padding:12px 14px;border-radius:12px;background:#eaf9f7;border:1px solid #bde2de;color:#137779;font-weight:950}.patient{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}.patient div{background:#f7fbfd;border:1px solid var(--line);border-radius:14px;padding:12px}.tag{display:inline-block;border-radius:999px;background:#e9f6fb;color:#176984;font-weight:900;font-size:.75rem;padding:5px 8px;margin:3px 3px 3px 0}
@media(max-width:860px){.layout{grid-template-columns:1fr}.side{position:static}.phase-list{grid-template-columns:repeat(2,1fr)}.badge-box{display:none}}
@media(max-width:560px){.topbar{padding:10px 14px}.stats{display:none}.brand-logo{width:50px;height:50px}.brand-name{font-size:1.35rem}.brand-tagline{font-size:.68rem}.layout{padding:10px}.hero{padding:14px}.hero h1{font-size:1.35rem}.content{padding:18px}.phase-list{display:none}.abg-grid{grid-template-columns:repeat(2,1fr)}.options,.flow,.patient{grid-template-columns:1fr}.footer{align-items:flex-end;flex-wrap:wrap}.mini-table th,.mini-table td{padding:8px}}
