*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:linear-gradient(180deg,#f7fcff,#ecf8f7);color:var(--ink);min-height:100vh}button{font:inherit;cursor:pointer}.topbar{position:sticky;top:0;z-index:50;background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;padding:12px 18px;box-shadow:0 8px 24px rgba(11,31,51,.2)}.topbar-inner{max-width:1120px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:flex;align-items:center;gap:13px}.brand-logo{width:58px;height:58px;border-radius:17px;border:2px solid rgba(255,255,255,.55);background:rgba(255,255,255,.06);object-fit:contain;padding:6px}.brand-title{font-size:32px;font-weight:900;letter-spacing:-1px;line-height:1}.brand-title span:first-child{color:#fff}.brand-title span:last-child{color:#12c7c2}.tagline{margin-top:6px;color:rgba(255,255,255,.86);font-weight:650;font-size:15px}.top-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.small-btn,.ghost-btn,.primary-btn,.danger-btn{border:0;border-radius:999px;padding:11px 16px;font-weight:800}.small-btn{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.22)}.ghost-btn{background:#fff;color:var(--navy);border:1px solid var(--line)}.primary-btn{background:linear-gradient(135deg,var(--teal),var(--blue));color:#fff;box-shadow:0 10px 24px rgba(28,167,168,.25)}.danger-btn{background:#fff0f0;color:var(--danger);border:1px solid #ffd2d2}.wrap{max-width:1120px;margin:0 auto;padding:18px}.hero{background:linear-gradient(135deg,var(--navy),#0d3e5d);color:#fff;border-radius:28px;padding:25px;box-shadow:var(--shadow);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;inset:auto -40px -90px auto;width:260px;height:260px;border-radius:50%;background:rgba(28,167,168,.18)}.eyebrow{letter-spacing:.24em;text-transform:uppercase;color:#9ae6e3;font-weight:900;font-size:13px}.hero h1{margin:10px 0 8px;font-size:clamp(29px,5vw,52px);line-height:1}.hero p{margin:0;color:rgba(255,255,255,.88);font-size:18px;max-width:780px}.hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:18px}.stat-card{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);border-radius:20px;padding:14px}.stat-card b{display:block;font-size:14px;color:#9ae6e3;text-transform:uppercase;letter-spacing:.12em}.stars{font-size:31px;letter-spacing:2px;color:var(--gold);text-shadow:0 2px 0 rgba(0,0,0,.1);white-space:nowrap}.meter{height:10px;background:rgba(255,255,255,.18);border-radius:999px;overflow:hidden;margin-top:12px}.meter>span{display:block;height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));width:0%;transition:.35s}.layout{display:grid;grid-template-columns:300px minmax(0,1fr);gap:18px;margin-top:18px}.panel,.card{background:#fff;border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.panel{padding:18px;align-self:start;position:sticky;top:100px}.panel h3{margin:0 0 10px}.legend{display:grid;gap:9px;margin-top:12px}.legend .row{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #eef4f7;padding:9px 0;color:var(--muted);font-size:14px}.legend .row strong{color:var(--ink)}.card{padding:22px}.card h2{margin:0 0 10px;font-size:30px;color:#10243a}.lead{color:var(--muted);font-size:17px;line-height:1.5}.pillrow{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.pill{border-radius:999px;background:#effafb;border:1px solid #cdebed;color:#0e6d70;padding:7px 10px;font-weight:800;font-size:13px}.abg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0}.abg-box{background:linear-gradient(180deg,#f8fcff,#eef8fb);border:1px solid var(--line);border-radius:18px;padding:14px;text-align:center}.abg-box .label{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:900}.abg-box .val{font-size:26px;font-weight:900;color:var(--navy);margin-top:4px}.scenario{background:#f7fbff;border:1px solid var(--line);border-radius:18px;padding:15px;line-height:1.5}.scenario strong{color:var(--navy)}.options{display:grid;gap:10px;margin-top:16px}.option{border:2px solid var(--line);background:#fff;border-radius:18px;padding:14px;text-align:left;font-weight:800;color:var(--ink);transition:.15s}.option:hover{border-color:var(--teal);transform:translateY(-1px)}.option.selected{border-color:var(--teal);background:#eaffff;box-shadow:0 8px 18px rgba(28,167,168,.13)}.option.correct{border-color:var(--ok);background:#edfff6}.option.wrong{border-color:var(--danger);background:#fff3f3}.nav{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:18px}.nav .primary-btn:disabled{opacity:.45;cursor:not-allowed}.feedback{margin-top:14px;border-radius:18px;padding:14px;font-weight:750}.feedback.ok{background:#ecfff6;border:1px solid #bcebd5;color:#155d41}.feedback.bad{background:#fff4f4;border:1px solid #ffd0d0;color:#7b2424}.result-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:16px 0}.result-card{border:1px solid var(--line);border-radius:18px;padding:15px;background:#fbfeff}.result-card h4{margin:0 0 8px}.status{font-weight:900;border-radius:999px;padding:5px 9px;font-size:12px;display:inline-block}.mastered{background:#eafbf4;color:#126644}.developing{background:#fff7df;color:#7b5411}.review{background:#fff0f0;color:#8d2b2b}.miss-list{display:grid;gap:12px;margin-top:14px}.miss{border:1px solid var(--line);border-radius:18px;padding:14px;background:#fbfdff}.miss h4{margin:0 0 6px}.notice{background:#f0fbfb;border:1px solid #cceeed;border-radius:18px;padding:14px;margin:14px 0;color:#20545d}.hidden{display:none!important}.certificate{border:3px solid var(--teal);background:linear-gradient(180deg,#fff,#f3ffff);border-radius:24px;padding:26px;text-align:center;margin-top:16px}.certificate h2{font-size:34px;margin-bottom:4px}.tiny{font-size:12px;color:var(--muted);line-height:1.4}.footer-space{height:30px}@media(max-width:860px){.topbar-inner{align-items:flex-start}.brand-title{font-size:28px}.brand-logo{width:54px;height:54px}.tagline{font-size:14px}.top-actions{display:none}.wrap{padding:14px}.hero{border-radius:22px;padding:20px}.hero-grid{grid-template-columns:1fr}.layout{grid-template-columns:1fr}.panel{position:static;order:2}.card{padding:18px;border-radius:22px}.abg-grid{grid-template-columns:repeat(2,1fr)}.result-grid{grid-template-columns:1fr}.stars{font-size:28px}.nav{position:sticky;bottom:0;background:rgba(247,252,255,.92);backdrop-filter:blur(8px);padding:10px;border-top:1px solid var(--line);margin-left:-18px;margin-right:-18px;margin-bottom:-18px;border-radius:0 0 20px 20px}.primary-btn,.ghost-btn,.danger-btn{padding:11px 13px}}@media print{.topbar,.panel,.nav,.no-print{display:none!important}.layout{display:block}.card,.certificate{box-shadow:none;border-color:#333}.hero{background:#fff;color:#111;box-shadow:none;border:1px solid #333}.hero p,.eyebrow{color:#222}}
</style>
