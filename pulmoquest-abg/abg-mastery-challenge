<body>
<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <img class="brand-logo" src="data:image/png;base64," alt="PulmoQuest logo">
      <div><div class="brand-title"><span>Pulmo</span><span>Quest</span></div><div class="tagline">Interactive respiratory therapy education.</div></div>
    </div>
    <div class="top-actions"><button class="small-btn" id="resumeBtn">Resume Challenge</button><button class="small-btn" id="resetBtn">Reset Mastery</button></div>
  </div>
</header>
<main class="wrap">
  <section class="hero">
    <div class="eyebrow">Final Shift</div>
    <h1>ABG Mastery Challenge</h1>
    <p>Interpret 25 randomized ABG cases across oxygen devices, ventilator settings, metabolic problems, mixed disorders, specimen concerns, and clinical decision points.</p>
    <div class="hero-grid">
      <div class="stat-card"><b>Live star rating</b><div class="stars" id="liveStars">★★★★★</div><div class="tiny">Start with 5 stars. A missed answer lowers the rating by 1. A correct answer restores 1 star, up to a maximum of 5.</div></div>
      <div class="stat-card"><b>Challenge progress</b><div style="display:flex;justify-content:space-between;margin-top:8px"><span id="progressText">Ready</span><span id="scoreText">0/25</span></div><div class="meter"><span id="progressBar"></span></div></div>
    </div>
  </section>
  <section class="layout">
    <aside class="panel">
      <h3>Mastery dashboard</h3>
      <div class="legend">
        <div class="row"><span>Current stars</span><strong id="sideStars">★★★★★</strong></div>
        <div class="row"><span>Correct</span><strong id="sideCorrect">0</strong></div>
        <div class="row"><span>Missed</span><strong id="sideMissed">0</strong></div>
        <div class="row"><span>Best saved</span><strong id="bestSaved">—</strong></div>
      </div>
      <div class="notice tiny"><strong>Scoring rule:</strong> The star meter moves during the challenge. Correct answers add 1 star. Missed answers subtract 1 star. The rating cannot go above 5 or below 0.</div>
      <button class="primary-btn" id="practiceBtn" style="width:100%;margin-top:8px">Start New 25-Case Challenge</button>
    </aside>
    <section class="card" id="app"><h2>Loading…</h2></section>
  </section>
  <div class="footer-space"></div>
</main>
<script>
const STORAGE_KEY='pulmoquest_abg_mastery_challenge_v1';
const CASE_POOL=[
{id:'M01',title:'Patient Encounter 01',setting:'PACU · Room air · drowsy after opioids',abg:{ph:'7.28',paco2:'58',hco3:'26',pao2:'62'},q:'What is the best interpretation?',options:['Acute respiratory acidosis with mild hypoxemia','Metabolic acidosis with appropriate compensation','Respiratory alkalosis with normal oxygenation','Normal ABG with mild hypoxemia'],a:0,skills:['primary','oxygenation','clinical'],critical:true,r:'The low pH and high PaCO₂ indicate respiratory acidosis. PaO₂ 62 is mild hypoxemia. The clinical story supports hypoventilation after opioids.'},
{id:'M02',title:'Patient Encounter 02',setting:'ED triage · Room air · anxious, tingling fingers',abg:{ph:'7.52',paco2:'26',hco3:'22',pao2:'96'},q:'What is the best interpretation?',options:['Metabolic alkalosis with normal oxygenation','Respiratory alkalosis with normal oxygenation','Partially compensated respiratory acidosis','Severe hypoxemia due to shunt'],a:1,skills:['primary','oxygenation'],critical:false,r:'High pH with low PaCO₂ indicates respiratory alkalosis. PaO₂ is normal.'},
{id:'M03',title:'Patient Encounter 03',setting:'ICU · Room air · Kussmaul respirations, glucose elevated',abg:{ph:'7.18',paco2:'22',hco3:'8',pao2:'91'},q:'What is the best interpretation?',options:['Metabolic acidosis with respiratory compensation and normal oxygenation','Respiratory alkalosis with metabolic compensation','Metabolic alkalosis with hypoxemia','Uncompensated respiratory acidosis'],a:0,skills:['compensation','metabolic','oxygenation','clinical'],critical:true,r:'Very low HCO₃⁻ drives the acidosis. PaCO₂ is appropriately low from hyperventilation. PaO₂ is normal.'},
{id:'M04',title:'Patient Encounter 04',setting:'Clinic · 2 L/min nasal cannula · known severe COPD',abg:{ph:'7.36',paco2:'62',hco3:'34',pao2:'68'},q:'What is the best interpretation?',options:['Acute respiratory alkalosis with mild hypoxemia','Chronic respiratory acidosis with mild hypoxemia','Uncompensated metabolic alkalosis with normal oxygenation','Normal ABG; no disorder present'],a:1,skills:['chronic','compensation','oxygenation'],critical:false,r:'Near-normal pH with high PaCO₂ and elevated HCO₃⁻ fits chronic respiratory acidosis. PaO₂ 68 is mild hypoxemia.'},
{id:'M05',title:'Patient Encounter 05',setting:'Med-surg · Room air · vomiting and NG suction',abg:{ph:'7.50',paco2:'46',hco3:'34',pao2:'88'},q:'What is the best interpretation?',options:['Metabolic alkalosis with normal oxygenation','Respiratory acidosis with metabolic compensation','Metabolic acidosis with normal oxygenation','Respiratory alkalosis with mild hypoxemia'],a:0,skills:['primary','metabolic','oxygenation'],critical:false,r:'High pH with high HCO₃⁻ indicates metabolic alkalosis. PaO₂ is normal.'},
{id:'M06',title:'Patient Encounter 06',setting:'ICU · 4 L/min nasal cannula · febrile, hypotensive',abg:{ph:'7.25',paco2:'28',hco3:'12',pao2:'70'},q:'What is the best interpretation?',options:['Respiratory alkalosis only','Metabolic acidosis with respiratory compensation and mild hypoxemia','Metabolic alkalosis with severe hypoxemia','Chronic respiratory acidosis with mild hypoxemia'],a:1,skills:['metabolic','compensation','oxygenation','clinical'],critical:true,r:'Low pH and low HCO₃⁻ indicate metabolic acidosis. Low PaCO₂ shows compensatory hyperventilation. PaO₂ 70 is mild hypoxemia.'},
{id:'M07',title:'Patient Encounter 07',setting:'ED · Room air · sudden dyspnea and pleuritic chest pain',abg:{ph:'7.49',paco2:'29',hco3:'22',pao2:'58'},q:'What is the best interpretation?',options:['Respiratory alkalosis with moderate hypoxemia','Metabolic acidosis with normal oxygenation','Respiratory acidosis with moderate hypoxemia','Normal acid-base with mild hypoxemia'],a:0,skills:['primary','oxygenation','clinical'],critical:true,r:'High pH and low PaCO₂ indicate respiratory alkalosis. PaO₂ 58 is moderate hypoxemia.'},
{id:'M08',title:'Patient Encounter 08',setting:'Ventilator · FiO₂ 0.80 · PEEP 12 · bilateral infiltrates',abg:{ph:'7.32',paco2:'44',hco3:'22',pao2:'62'},q:'Which concern is most important?',options:['Oxygenation is acceptable for FiO₂ 0.80','Severe gas-exchange impairment despite high FiO₂','Primary metabolic alkalosis is the priority','The ABG is normal for ventilated patients'],a:1,skills:['oxygenation','pf','clinical'],critical:true,r:'PaO₂ 62 on FiO₂ 0.80 gives a very low P/F ratio, indicating severe oxygenation impairment despite high oxygen.'},
{id:'M09',title:'Patient Encounter 09',setting:'ICU · Room air · shallow breathing, weak cough',abg:{ph:'7.24',paco2:'72',hco3:'30',pao2:'50'},q:'What is the best interpretation?',options:['Metabolic alkalosis with moderate hypoxemia','Acute on chronic respiratory acidosis with moderate hypoxemia','Respiratory alkalosis with severe hypoxemia','Normal compensated ABG'],a:1,skills:['chronic','compensation','oxygenation','clinical'],critical:true,r:'Very high PaCO₂ with acidemia indicates ventilatory failure. Elevated HCO₃⁻ suggests a chronic component, but the low pH indicates acute worsening. PaO₂ 50 is moderate hypoxemia.'},
{id:'M10',title:'Patient Encounter 10',setting:'ED · Room air · tinnitus, nausea, tachypnea',abg:{ph:'7.44',paco2:'22',hco3:'15',pao2:'99'},q:'What pattern is most likely?',options:['Simple respiratory alkalosis only','Mixed respiratory alkalosis and metabolic acidosis','Simple metabolic alkalosis','Chronic respiratory acidosis'],a:1,skills:['mixed','compensation','clinical'],critical:true,r:'Low PaCO₂ and low HCO₃⁻ together with near-normal pH suggest opposing primary processes rather than simple compensation.'},
{id:'M11',title:'Patient Encounter 11',setting:'ABG sample note · visible air bubble left in syringe',abg:{ph:'7.48',paco2:'30',hco3:'22',pao2:'122'},q:'What is the best action?',options:['Accept the sample and report severe hyperoxia','Question/recollect because air contamination may alter gases','Diagnose metabolic alkalosis','Increase FiO₂ immediately'],a:1,skills:['sample','validation'],critical:true,r:'A visible air bubble can alter PaO₂ and PaCO₂. The safest interpretation is to question or recollect the specimen.'},
{id:'M12',title:'Patient Encounter 12',setting:'Room air · SpO₂ 98% · difficult stick, dark blood noted',abg:{ph:'7.37',paco2:'46',hco3:'26',pao2:'36'},q:'What is the best action?',options:['Report severe hypoxemia without question','Question whether the specimen is arterial','Diagnose acute respiratory acidosis only','Ignore the oxygen result but accept all others'],a:1,skills:['sample','validation','oxygenation'],critical:true,r:'PaO₂ 36 conflicts with SpO₂ 98% and the collection story. A venous or compromised sample should be considered.'},
{id:'M13',title:'Patient Encounter 13',setting:'Sample sat at room temperature for 55 minutes before analysis',abg:{ph:'7.31',paco2:'49',hco3:'24',pao2:'64'},q:'What should the RT do first?',options:['Interpret as definitive respiratory acidosis','Question reliability because analysis was delayed','Classify as metabolic acidosis only','Increase oxygen based only on this ABG'],a:1,skills:['sample','validation'],critical:true,r:'Significant delay can change blood gas values. The sample should be questioned before using it for major decisions.'},
{id:'M14',title:'Patient Encounter 14',setting:'ED · continuous bronchodilators · worsening fatigue',abg:{ph:'7.31',paco2:'50',hco3:'24',pao2:'66'},q:'Why is this ABG concerning?',options:['PaCO₂ is low, showing effective hyperventilation','Rising PaCO₂ with acidemia suggests ventilatory failure','HCO₃⁻ is high, showing chronic compensation','The PaO₂ is normal'],a:1,skills:['clinical','primary','oxygenation'],critical:true,r:'In an asthma exacerbation, a normal or high PaCO₂ with acidemia can signal fatigue and impending ventilatory failure.'},
{id:'M15',title:'Patient Encounter 15',setting:'Ventilator · rate increased 3 minutes before ABG',abg:{ph:'7.26',paco2:'58',hco3:'25',pao2:'88'},q:'What is the best interpretation step?',options:['Use this as final response to the vent change','Recognize the ABG may be too soon after a ventilator change','Diagnose chronic metabolic alkalosis','Ignore the PaCO₂'],a:1,skills:['validation','clinical','ventilator'],critical:false,r:'ABGs drawn too soon after a ventilator change may not reflect the patient’s new steady state.'},
{id:'M16',title:'Patient Encounter 16',setting:'Ventilator · FiO₂ 0.40 · patient riding set rate',abg:{ph:'7.55',paco2:'24',hco3:'22',pao2:'142'},q:'What is the best interpretation?',options:['Respiratory alkalosis with high PaO₂ on supplemental oxygen','Metabolic alkalosis with severe hypoxemia','Respiratory acidosis with normal oxygenation','Normal ventilator ABG'],a:0,skills:['primary','oxygenation','ventilator'],critical:false,r:'High pH and low PaCO₂ indicate respiratory alkalosis. PaO₂ is high in the context of FiO₂ 0.40.'},
{id:'M17',title:'Patient Encounter 17',setting:'ICU · vomiting, diuretics · 2 L/min nasal cannula',abg:{ph:'7.49',paco2:'49',hco3:'36',pao2:'78'},q:'What is the best interpretation?',options:['Metabolic alkalosis with respiratory compensation and mild hypoxemia','Respiratory acidosis with no compensation','Metabolic acidosis with normal oxygenation','Respiratory alkalosis with mild hypoxemia'],a:0,skills:['metabolic','compensation','oxygenation'],critical:false,r:'High pH and high HCO₃⁻ indicate metabolic alkalosis. PaCO₂ is elevated in the compensatory direction. PaO₂ 78 is mild hypoxemia.'},
{id:'M18',title:'Patient Encounter 18',setting:'ICU · septic shock · tachypneic but tiring',abg:{ph:'7.12',paco2:'42',hco3:'13',pao2:'71'},q:'What is the best final interpretation?',options:['Uncompensated metabolic acidosis only','Mixed metabolic acidosis and respiratory acidosis with mild hypoxemia','Fully compensated metabolic acidosis','Respiratory alkalosis with mild hypoxemia'],a:1,skills:['mixed','compensation','oxygenation'],critical:true,r:'With HCO₃⁻ 13, expected PaCO₂ should be lower. A PaCO₂ of 42 is too high for compensation and adds respiratory acidosis.'},
{id:'M19',title:'Patient Encounter 19',setting:'ED · abdominal pain · very anxious and tachypneic',abg:{ph:'7.46',paco2:'18',hco3:'13',pao2:'101'},q:'What pattern is most likely?',options:['Metabolic acidosis with additional respiratory alkalosis','Simple metabolic alkalosis','Chronic respiratory acidosis','Normal ABG'],a:0,skills:['mixed','compensation'],critical:true,r:'Low HCO₃⁻ indicates metabolic acidosis, but PaCO₂ is lower than expected and pH is alkalemic, suggesting an added respiratory alkalosis.'},
{id:'M20',title:'Patient Encounter 20',setting:'Med-surg · diarrhea · room air',abg:{ph:'7.29',paco2:'31',hco3:'15',pao2:'86'},q:'What is the best interpretation?',options:['Metabolic acidosis with respiratory compensation and normal oxygenation','Respiratory acidosis with normal oxygenation','Metabolic alkalosis with normal oxygenation','Respiratory alkalosis only'],a:0,skills:['metabolic','compensation','oxygenation'],critical:false,r:'Low pH and low HCO₃⁻ indicate metabolic acidosis. PaCO₂ is low in compensation. Oxygenation is normal.'},
{id:'M21',title:'Patient Encounter 21',setting:'Room air · cyanotic, severe dyspnea',abg:{ph:'7.41',paco2:'39',hco3:'24',pao2:'38'},q:'What is the priority finding?',options:['Normal acid-base with severe hypoxemia','Respiratory alkalosis with normal oxygenation','Metabolic acidosis with mild hypoxemia','Normal ABG'],a:0,skills:['oxygenation','clinical'],critical:true,r:'Acid-base values are normal, but PaO₂ 38 is severe hypoxemia and is the priority.'},
{id:'M22',title:'Patient Encounter 22',setting:'Ventilator · FiO₂ 0.50 · stable settings',abg:{ph:'7.39',paco2:'41',hco3:'24',pao2:'75'},q:'What is the best oxygenation interpretation?',options:['PaO₂ is appropriate for FiO₂ 0.50','PaO₂ is low for FiO₂ 0.50 and suggests impaired gas exchange','Severe respiratory acidosis is present','The ABG proves no lung problem'],a:1,skills:['oxygenation','pf','clinical'],critical:false,r:'On FiO₂ 0.50, PaO₂ 75 is lower than expected for normal lung function, suggesting impaired gas exchange.'},
{id:'M23',title:'Patient Encounter 23',setting:'Pregnancy/hyperventilation pattern · room air',abg:{ph:'7.43',paco2:'30',hco3:'20',pao2:'98'},q:'What does this pattern most closely fit?',options:['Chronic respiratory alkalosis with normal oxygenation','Acute respiratory acidosis','Metabolic acidosis with severe hypoxemia','Metabolic alkalosis'],a:0,skills:['chronic','compensation','oxygenation'],critical:false,r:'Low PaCO₂ with near-normal pH and lower HCO₃⁻ fits chronic respiratory alkalosis. PaO₂ is normal.'},
{id:'M24',title:'Patient Encounter 24',setting:'Sudden hypoventilation · no known chronic lung disease',abg:{ph:'7.32',paco2:'50',hco3:'25',pao2:'84'},q:'What is the best interpretation?',options:['Acute respiratory acidosis with normal oxygenation','Chronic respiratory acidosis with normal oxygenation','Metabolic alkalosis with normal oxygenation','Fully compensated respiratory acidosis'],a:0,skills:['chronic','compensation','primary'],critical:false,r:'A PaCO₂ increase of about 10 with pH drop near 0.08 and HCO₃⁻ near 25 fits acute respiratory acidosis/buffering.'},
{id:'M25',title:'Patient Encounter 25',setting:'Known COPD · stable outpatient · room air',abg:{ph:'7.34',paco2:'60',hco3:'32',pao2:'60'},q:'What is the best interpretation?',options:['Chronic respiratory acidosis with mild hypoxemia','Acute respiratory alkalosis with normal oxygenation','Metabolic acidosis with severe hypoxemia','Normal ABG'],a:0,skills:['chronic','compensation','oxygenation'],critical:false,r:'High PaCO₂ with elevated HCO₃⁻ and near-normal pH fits chronic respiratory acidosis. PaO₂ 60 is mild hypoxemia.'},
{id:'M26',title:'Patient Encounter 26',setting:'ED · room air · dehydration and diarrhea',abg:{ph:'7.22',paco2:'28',hco3:'11',pao2:'93'},q:'What is the best interpretation?',options:['Metabolic acidosis with respiratory compensation and normal oxygenation','Respiratory alkalosis only','Metabolic alkalosis with normal oxygenation','Respiratory acidosis with severe hypoxemia'],a:0,skills:['metabolic','compensation','oxygenation'],critical:false,r:'Low pH and low HCO₃⁻ indicate metabolic acidosis. Low PaCO₂ is compensatory. Oxygenation is normal.'},
{id:'M27',title:'Patient Encounter 27',setting:'Procedure suite · 3 L/min nasal cannula · difficult to arouse',abg:{ph:'7.18',paco2:'80',hco3:'29',pao2:'74'},q:'What is the priority interpretation?',options:['Acute ventilatory failure with respiratory acidosis and mild hypoxemia','Metabolic alkalosis only','Respiratory alkalosis with normal oxygenation','Normal ABG for sedation'],a:0,skills:['primary','clinical','oxygenation'],critical:true,r:'Severe acidemia with very high PaCO₂ indicates acute ventilatory failure. Mild hypoxemia is also present.'},
{id:'M28',title:'Patient Encounter 28',setting:'Nonrebreather mask · FiO₂ high but unknown',abg:{ph:'7.38',paco2:'40',hco3:'24',pao2:'240'},q:'What information is most important for interpreting oxygenation?',options:['Patient temperature only','Oxygen device/FiO₂ and whether the sample timing matches therapy','HCO₃⁻ trend only','Whether the pH is exactly 7.40'],a:1,skills:['oxygenation','validation','clinical'],critical:false,r:'PaO₂ must be interpreted in context of oxygen device, FiO₂, and timing.'},
{id:'M29',title:'Patient Encounter 29',setting:'ABG analyzer warning · clot detected',abg:{ph:'7.36',paco2:'44',hco3:'24',pao2:'82'},q:'What is the best action?',options:['Accept because numbers look normal','Recollect because the clotted specimen is unreliable','Diagnose respiratory acidosis','Report only the PaO₂'],a:1,skills:['sample','validation'],critical:true,r:'A clotted specimen should not be treated as reliable even if the displayed numbers look plausible.'},
{id:'M30',title:'Patient Encounter 30',setting:'ICU · room air · Hb 6.8 g/dL, SpO₂ 98%',abg:{ph:'7.40',paco2:'40',hco3:'24',pao2:'94'},q:'What is the best clinical interpretation?',options:['Normal ABG rules out tissue hypoxia','Acid-base and PaO₂ are normal, but low hemoglobin may still impair oxygen delivery','Severe hypoxemia is present','Respiratory alkalosis is present'],a:1,skills:['clinical','oxygenation'],critical:false,r:'PaO₂ can be normal while oxygen delivery is impaired by severe anemia. ABG interpretation must be connected to patient assessment.'},
{id:'M31',title:'Patient Encounter 31',setting:'ED · room air · suspected overdose, Na 140, Cl 100',abg:{ph:'7.20',paco2:'24',hco3:'9',pao2:'88'},q:'Which added calculation is most useful?',options:['Anion gap to characterize metabolic acidosis','Static compliance only','Peak inspiratory pressure only','No additional calculation is relevant'],a:0,skills:['metabolic','clinical'],critical:false,r:'A severe metabolic acidosis should prompt characterization, such as anion gap when electrolytes are available.'},
{id:'M32',title:'Patient Encounter 32',setting:'Before/after oxygen · PaO₂ rose from 48 on RA to 105 on FiO₂ 0.40',abg:{ph:'7.37',paco2:'42',hco3:'24',pao2:'105'},q:'What does the response suggest?',options:['Oxygenation improved with supplemental oxygen','Refractory shunt with no oxygen response','Primary respiratory alkalosis','Invalid result because PaO₂ cannot rise'],a:0,skills:['oxygenation','clinical'],critical:false,r:'A meaningful rise in PaO₂ after increased FiO₂ suggests oxygen-responsive hypoxemia rather than completely refractory shunt.'},
{id:'M33',title:'Patient Encounter 33',setting:'ARDS · FiO₂ increased from 0.60 to 1.00, PaO₂ 58 to 62',abg:{ph:'7.33',paco2:'48',hco3:'24',pao2:'62'},q:'What is the best interpretation of oxygen response?',options:['Strong response to oxygen','Minimal PaO₂ response suggests refractory hypoxemia/shunt physiology','Oxygenation is normal','Metabolic alkalosis is the primary issue'],a:1,skills:['oxygenation','pf','clinical'],critical:true,r:'A very small PaO₂ increase despite a large FiO₂ increase suggests refractory hypoxemia and shunt physiology.'},
{id:'M34',title:'Patient Encounter 34',setting:'Room air · patient pain-hyperventilating',abg:{ph:'7.51',paco2:'28',hco3:'22',pao2:'110'},q:'How should the high PaO₂ be considered?',options:['It may be elevated partly because low PaCO₂/hyperventilation affects PaO₂','It proves excessive FiO₂ was used','It means the sample is venous','It proves metabolic alkalosis'],a:0,skills:['oxygenation','clinical'],critical:false,r:'Hyperventilation lowers PaCO₂ and can raise PaO₂ on room air; oxygenation should be interpreted with ventilation context.'},
{id:'M35',title:'Patient Encounter 35',setting:'ICU · room air · improving DKA',abg:{ph:'7.39',paco2:'25',hco3:'15',pao2:'92'},q:'What is the best interpretation?',options:['Normal ABG because pH is normal','Compensated metabolic acidosis with normal oxygenation','Metabolic alkalosis with normal oxygenation','Respiratory acidosis with hypoxemia'],a:1,skills:['compensation','metabolic','oxygenation'],critical:true,r:'Normal pH does not mean normal ABG. Low HCO₃⁻ with low PaCO₂ indicates compensated metabolic acidosis.'},
{id:'M36',title:'Patient Encounter 36',setting:'COPD exacerbation · 4 L/min nasal cannula · somnolent',abg:{ph:'7.25',paco2:'78',hco3:'34',pao2:'58'},q:'What is the best interpretation?',options:['Acute on chronic respiratory acidosis with moderate hypoxemia','Metabolic alkalosis with normal oxygenation','Respiratory alkalosis with moderate hypoxemia','Normal chronic COPD baseline'],a:0,skills:['chronic','clinical','oxygenation'],critical:true,r:'Elevated HCO₃⁻ suggests chronic retention, but low pH and very high PaCO₂ indicate acute worsening. PaO₂ 58 is moderate hypoxemia.'},
{id:'M37',title:'Patient Encounter 37',setting:'ICU · diuretics · room air',abg:{ph:'7.58',paco2:'52',hco3:'47',pao2:'82'},q:'What is the best interpretation?',options:['Metabolic alkalosis with respiratory compensation and normal oxygenation','Acute respiratory acidosis with normal oxygenation','Metabolic acidosis with compensation','Respiratory alkalosis with severe hypoxemia'],a:0,skills:['metabolic','compensation','oxygenation'],critical:false,r:'High pH and very high HCO₃⁻ indicate metabolic alkalosis. Elevated PaCO₂ is in the compensatory direction. PaO₂ is normal.'},
{id:'M38',title:'Patient Encounter 38',setting:'Room air · shallow breathing from overdose',abg:{ph:'7.27',paco2:'65',hco3:'29',pao2:'65'},q:'Why can PaO₂ be low here?',options:['Hypoventilation raises PaCO₂ and can lower PaO₂ even without primary lung shunt','Low HCO₃⁻ is causing hypoxemia','PaO₂ 65 is normal','This must be a venous sample'],a:0,skills:['oxygenation','clinical','primary'],critical:false,r:'Hypoventilation can elevate PaCO₂ and reduce alveolar/arterial oxygenation. Context matters before assuming shunt.'},
{id:'M39',title:'Patient Encounter 39',setting:'Room air · stable patient',abg:{ph:'7.41',paco2:'39',hco3:'24',pao2:'90'},q:'What is the approximate P/F ratio and interpretation?',options:['About 429; oxygenation is appropriate on room air','About 90; severe ARDS','About 189; moderate impairment','Cannot calculate P/F on room air'],a:0,skills:['pf','oxygenation'],critical:false,r:'P/F = 90 / 0.21 ≈ 429, which is appropriate oxygenation on room air.'},
{id:'M40',title:'Patient Encounter 40',setting:'Patient is cyanotic, gasping, SpO₂ 62%, ABG not yet drawn',abg:{ph:'—',paco2:'—',hco3:'—',pao2:'—'},q:'What should happen first?',options:['Wait for an ABG before treating','Stabilize oxygenation/ventilation immediately while preparing further assessment','Calculate anion gap first','Document normal acid-base status'],a:1,skills:['clinical','safety'],critical:true,r:'ABGs support assessment, but obvious instability should be treated immediately. Do not delay stabilization to obtain numbers.'}
];
let state={mode:'intro',cases:[],idx:0,stars:5,correct:0,missed:0,answers:[],selected:null,started:false};
const app=document.getElementById('app');
function loadBest(){try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||'{}')}catch(e){return {}}}
function saveBest(){const best=loadBest();const score=state.correct;const pct=Math.round((state.correct/state.cases.length)*100)||0;const record={bestStars:Math.max(best.bestStars||0,state.stars),bestScore:Math.max(best.bestScore||0,pct),lastScore:pct,lastStars:state.stars,lastDate:new Date().toLocaleDateString(),attempts:(best.attempts||0)+1};localStorage.setItem(STORAGE_KEY,JSON.stringify(record));}
function shuffle(arr){return [...arr].sort(()=>Math.random()-.5)}
function pickCases(){return shuffle(CASE_POOL).slice(0,25)}
function starsText(n){return '★'.repeat(n)+'☆'.repeat(5-n)}
function updateDash(){document.getElementById('liveStars').textContent=starsText(state.stars);document.getElementById('sideStars').textContent=starsText(state.stars);document.getElementById('sideCorrect').textContent=state.correct;document.getElementById('sideMissed').textContent=state.missed;const best=loadBest();document.getElementById('bestSaved').textContent=best.bestScore?`${best.bestScore}% · ${starsText(best.bestStars||0)}`:'—';document.getElementById('progressText').textContent=state.started?`Case ${Math.min(state.idx+1,state.cases.length)} of ${state.cases.length}`:'Ready';document.getElementById('scoreText').textContent=`${state.correct}/${state.cases.length||25}`;document.getElementById('progressBar').style.width=state.started?`${(state.idx/state.cases.length)*100}%`:'0%'}
function startChallenge(){state={mode:'case',cases:pickCases(),idx:0,stars:5,correct:0,missed:0,answers:[],selected:null,started:true};renderCase();}
function renderIntro(){state.mode='intro';state.started=false;updateDash();app.innerHTML=`<h2>Final Shift Briefing</h2><p class="lead">You will receive 25 randomized ABG encounters. Each item represents a bedside interpretation, validation, or clinical decision point.</p><div class="notice"><strong>How the 5-star rating works:</strong> You begin with 5 stars. If you miss an answer, you lose 1 star. If you answer correctly, you gain 1 star, up to a maximum of 5. The rating cannot go below 0.</div><div class="scenario"><strong>Before starting, remember the full workflow:</strong><br>1. Decide whether the sample and clinical context can be trusted.<br>2. Interpret pH, PaCO₂, HCO₃⁻, and oxygenation.<br>3. Check compensation and expected values when needed.<br>4. Consider FiO₂, ventilator changes, serial trends, and patient assessment.<br>5. Choose the safest respiratory care conclusion.</div><div class="nav"><button class="ghost-btn" onclick="location.href='pulmoquest_level5.html'">Back to Level 5</button><button class="primary-btn" onclick="startChallenge()">Begin 25-Case Challenge</button></div>`;}
function renderCase(){const c=state.cases[state.idx];state.selected=null;updateDash();let abg='';for(const [k,v] of Object.entries(c.abg)){abg+=`<div class="abg-box"><div class="label">${k==='ph'?'pH':k==='paco2'?'PaCO₂':k==='hco3'?'HCO₃⁻':'PaO₂'}</div><div class="val">${v}</div></div>`}
app.innerHTML=`<div class="eyebrow" style="color:var(--teal)">Case ${state.idx+1} of ${state.cases.length}</div><div class="scenario"><strong>Setting:</strong> ${c.setting}</div><div class="abg-grid">${abg}</div><h3>${c.q}</h3><div class="options" id="opts">${c.options.map((o,i)=>`<button class="option" data-i="${i}">${o}</button>`).join('')}</div><div id="caseFeedback"></div><div class="nav"><button class="ghost-btn" onclick="confirmQuit()">Exit</button><button class="primary-btn" id="submitBtn" disabled>Submit Answer</button></div>`;
document.querySelectorAll('.option').forEach(btn=>btn.addEventListener('click',()=>{state.selected=Number(btn.dataset.i);document.querySelectorAll('.option').forEach(b=>b.classList.remove('selected'));btn.classList.add('selected');document.getElementById('submitBtn').disabled=false;}));
document.getElementById('submitBtn').addEventListener('click',submitAnswer);
}
function submitAnswer(){const c=state.cases[state.idx];const correct=state.selected===c.a;if(correct){state.correct++;state.stars=Math.min(5,state.stars+1)}else{state.missed++;state.stars=Math.max(0,state.stars-1)}state.answers.push({id:c.id,title:c.title,setting:c.setting,abg:c.abg,q:c.q,selected:state.selected,selectedText:c.options[state.selected],correctIndex:c.a,correctText:c.options[c.a],correct,skills:c.skills,critical:c.critical,r:c.r});document.querySelectorAll('.option').forEach((b)=>{b.disabled=true;const i=Number(b.dataset.i);if(i===c.a)b.classList.add('correct');if(i===state.selected&&i!==c.a)b.classList.add('wrong')});document.getElementById('caseFeedback').innerHTML=`<div class="feedback ${correct?'ok':'bad'}">${correct?'Correct.':'Missed.'} Star rating is now <strong>${starsText(state.stars)}</strong>.</div>`;document.getElementById('submitBtn').textContent=(state.idx===state.cases.length-1)?'View Results':'Next Case';document.getElementById('submitBtn').disabled=false;document.getElementById('submitBtn').onclick=()=>{state.idx++; if(state.idx>=state.cases.length)renderResults(); else renderCase();};updateDash();}
function skillSummary(){const all={primary:['Primary disorder'],metabolic:['Metabolic reasoning'],compensation:['Compensation'],chronic:['Acute/chronic'],mixed:['Mixed disorders'],oxygenation:['Oxygenation'],pf:['FiO₂ / P/F context'],sample:['Sample integrity'],validation:['Validation'],ventilator:['Ventilator context'],clinical:['Clinical decision-making'],safety:['Patient safety']};const summary={};for(const a of state.answers){for(const s of a.skills){if(!summary[s])summary[s]={label:all[s]?.[0]||s,total:0,correct:0,misses:[]};summary[s].total++;if(a.correct)summary[s].correct++;else summary[s].misses.push(a);}}return summary;}
function renderResults(){state.mode='results';state.started=false;document.getElementById('progressBar').style.width='100%';saveBest();updateDash();const pct=Math.round((state.correct/state.cases.length)*100);const summary=skillSummary();const criticalMiss=state.answers.filter(a=>!a.correct&&a.critical).length;let resultCards=Object.entries(summary).map(([k,s])=>{let cls=s.correct===s.total?'mastered':s.correct>0?'developing':'review';let label=s.correct===s.total?'Mastered':s.correct>0?'Developing':'Needs review';return `<div class="result-card"><h4>${s.label}</h4><span class="status ${cls}">${label} · ${s.correct}/${s.total}</span>${s.misses.length?`<div style="margin-top:10px"><button class="ghost-btn" onclick="renderReview('${k}')">Review ${s.label}</button></div>`:''}</div>`}).join('');
app.innerHTML=`<h2>ABG Mastery Challenge Complete</h2><div class="stars" style="font-size:46px">${starsText(state.stars)}</div><p class="lead"><strong>${state.correct} of ${state.cases.length}</strong> correct · ${pct}% · ${criticalMiss} critical miss${criticalMiss===1?'':'es'}</p><div class="notice"><strong>Best result saved.</strong> Repeat the challenge any time to improve the saved score and star rating.</div><div class="result-grid">${resultCards}</div><div class="nav"><button class="ghost-btn" onclick="renderMissed()">Review Missed Cases</button><button class="primary-btn" onclick="startChallenge()">Retry Random Challenge</button></div><div style="margin-top:12px"><button class="ghost-btn" onclick="renderCertificate()">View Printable Certificate</button></div>`;}
function renderReview(skill){const summary=skillSummary()[skill];let list=summary.misses.map(a=>missMarkup(a)).join('')||'<p class="lead">No missed cases for this skill.</p>';app.innerHTML=`<h2>Targeted Review: ${summary.label}</h2><p class="lead">Review the missed cases for this competency, then retry a new randomized challenge when ready.</p><div class="miss-list">${list}</div><div class="nav"><button class="ghost-btn" onclick="renderResults()">Back to Results</button><button class="primary-btn" onclick="startChallenge()">Retry Challenge</button></div>`;}
function missMarkup(a){let abg=Object.entries(a.abg).map(([k,v])=>`${k==='ph'?'pH':k==='paco2'?'PaCO₂':k==='hco3'?'HCO₃⁻':'PaO₂'} ${v}`).join(' · ');return `<div class="miss"><h4>${a.setting}</h4><div class="tiny"><strong>ABG:</strong> ${abg}</div><p><strong>Question:</strong> ${a.q}</p><p><strong>Your answer:</strong> ${a.selectedText||'No answer'}</p><p><strong>Correct answer:</strong> ${a.correctText}</p><p><strong>Why:</strong> ${a.r}</p></div>`;}
function renderMissed(){const misses=state.answers.filter(a=>!a.correct);app.innerHTML=`<h2>Missed Case Review</h2><p class="lead">These are the cases that lowered the star rating during this attempt.</p><div class="miss-list">${misses.length?misses.map(missMarkup).join(''):'<div class="notice">No missed cases. Excellent work.</div>'}</div><div class="nav"><button class="ghost-btn" onclick="renderResults()">Back to Results</button><button class="primary-btn" onclick="startChallenge()">Retry Challenge</button></div>`;}
function renderCertificate(){const best=loadBest();app.innerHTML=`<div class="certificate"><div class="eyebrow">PulmoQuest</div><h2>ABG Mastery Challenge</h2><p class="lead">Certificate of Completion</p><p>This certifies completion of the 25-case PulmoQuest ABG Mastery Challenge.</p><div class="stars" style="font-size:44px">${starsText(best.bestStars||state.stars||0)}</div><p><strong>Best score:</strong> ${best.bestScore||Math.round((state.correct/state.cases.length)*100)||0}%<br><strong>Date:</strong> ${best.lastDate||new Date().toLocaleDateString()}</p><p class="tiny">Educational simulation only. This activity supports respiratory therapy education and does not replace clinical judgment, institutional policy, or provider orders.</p></div><div class="nav no-print"><button class="ghost-btn" onclick="renderResults()">Back to Results</button><button class="primary-btn" onclick="window.print()">Print Certificate</button></div>`;}
function confirmQuit(){if(confirm('Exit this challenge attempt? Current attempt progress will not be saved as complete.'))renderIntro();}
document.getElementById('practiceBtn').addEventListener('click',startChallenge);document.getElementById('resumeBtn').addEventListener('click',()=>{if(state.started)renderCase();else renderIntro();});document.getElementById('resetBtn').addEventListener('click',()=>{if(confirm('Reset saved mastery challenge progress?')){localStorage.removeItem(STORAGE_KEY);renderIntro();}});
renderIntro();updateDash();
</script>
</body>
</html>
