<style>
:root{--navy:#0B1F33;--navy2:#143653;--teal:#1CA7A8;--blue:#4BA3F2;--ink:#173044;--muted:#60758a;--line:#d6e5ee;--bg:#eff8fb;--ok:#27875d;--bad:#c84d4d;--warn:#b87514;--shadow:0 16px 36px rgba(11,31,51,.12)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:linear-gradient(180deg,#f5fbff,#edf8f7);min-height:100vh}button,select{font:inherit}button{cursor:pointer}
.topbar{position:sticky;top:0;z-index:20;background:linear-gradient(135deg,var(--navy),var(--navy2));color:white;padding:12px 20px;box-shadow:0 8px 22px rgba(11,31,51,.2)}
.topbar-inner{max-width:1100px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:13px;min-width:0}.brand-logo{width:58px;height:58px;object-fit:cover;border-radius:17px;flex:0 0 auto}.brand-name{font-size:1.55rem;line-height:1;margin:0;font-weight:900;letter-spacing:-.04em;white-space:nowrap}.pulmo{color:#fff}.quest{color:var(--teal)}.brand-tagline{font-size:.78rem;color:#d6dbe4;margin:7px 0 0;font-weight:600;white-space:nowrap}.stats{display:flex;gap:8px;flex-wrap:wrap}.pill{font-size:.78rem;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.16)}
.layout{max-width:1100px;margin:auto;padding:18px;display:grid;grid-template-columns:225px minmax(0,1fr);gap:18px}.side{background:#fff;border:1px solid var(--line);border-radius:20px;padding:15px;box-shadow:var(--shadow);height:max-content;position:sticky;top:82px}.level{padding:15px;border-radius:16px;background:linear-gradient(145deg,var(--navy),var(--navy2));color:white}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.68rem;font-weight:900;color:#8ee0de}.level h2{font-size:1.15rem;margin:6px 0}.level p{font-size:.82rem;line-height:1.4;color:#d2e5f2;margin:0}.track{height:8px;background:rgba(255,255,255,.16);border-radius:99px;overflow:hidden;margin-top:12px}.fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));width:0;transition:.3s}.progress-label{font-size:.72rem;color:#d5e5ee;margin-top:5px;display:flex;justify-content:space-between}.phase-list{display:grid;gap:8px;margin-top:13px}.phase{padding:10px 11px;border-radius:12px;background:#f4f8fa;font-size:.82rem;font-weight:800;display:flex;gap:8px;align-items:center}.phase.active{background:#e8f8f6;color:#147779}.phase.done{color:var(--ok)}.phase-dot{width:22px;height:22px;border-radius:7px;background:#dce9ef;display:grid;place-items:center;font-size:.7rem}.phase.active .phase-dot{background:var(--teal);color:white}.badge{margin-top:13px;padding:12px;text-align:center;border-radius:14px;background:#eef8ff;border:1px solid #b9d9ef}.badge-orb{width:58px;height:58px;border-radius:50%;margin:auto;background:radial-gradient(circle at 35% 30%,#bfeaff,#357db1);border:5px solid #8cc8e8;display:grid;place-items:center;font-size:24px;filter:grayscale(1);opacity:.55}.badge-orb.on{filter:none;opacity:1}.badge strong{display:block;font-size:.85rem;margin-top:6px}.badge small{font-size:.72rem;color:var(--muted)}
.main{min-width:0}.hero{background:linear-gradient(135deg,#fff,#effbfb);border:1px solid var(--line);border-radius:20px;padding:16px 20px;box-shadow:var(--shadow);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;gap:16px}.hero h2{margin:4px 0 3px;color:var(--navy);font-size:1.55rem}.hero p{margin:0;color:var(--muted);font-size:.9rem}.step-count{white-space:nowrap;font-size:.82rem;font-weight:900;color:var(--teal)}
.card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);padding:20px;min-height:430px;display:flex;flex-direction:column}.content{flex:1}.card h3{margin:0 0 8px;color:var(--navy);font-size:1.3rem}.card p{color:var(--muted);line-height:1.5}.preceptor{display:grid;grid-template-columns:62px 1fr;gap:14px;align-items:start}.avatar{width:58px;height:58px;border-radius:18px;background:linear-gradient(135deg,var(--blue),var(--teal));display:grid;place-items:center;color:white;font-size:27px}.workflow{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:15px}.workflow div{padding:9px 5px;border:1px solid var(--line);border-radius:11px;text-align:center;font-size:.72rem;font-weight:800;background:#f5f9fb}.workflow span{display:block;width:22px;height:22px;border-radius:50%;margin:0 auto 5px;background:var(--teal);color:white;display:grid;place-items:center}
.values{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0}.value{padding:13px;border:1px solid var(--line);border-radius:15px;background:#fbfdfe}.value b{display:block;color:var(--navy);font-size:1.08rem}.value em{display:block;color:#147779;font-style:normal;font-size:.78rem;font-weight:800;margin:2px 0 4px}.value small{font-size:.76rem;color:var(--muted)}
.quiz{margin-top:14px;padding:15px;border:1px dashed #b9d2df;border-radius:16px;background:#f8fbfc}.question{font-weight:900;color:var(--navy);margin-bottom:11px}.options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.option{border:1px solid var(--line);background:white;padding:11px;border-radius:12px;font-weight:800;color:var(--ink)}.option:hover{border-color:var(--teal);background:#eefaf8}.option.correct{background:#e8f7ef;border-color:#86cba7;color:#176e47}.option.incorrect{background:#fff0f0;border-color:#e7a0a0;color:#9e3737}.feedback{display:none;margin-top:10px;padding:10px 12px;border-radius:11px;background:#edf6fa;font-size:.86rem}.feedback.show{display:block}.feedback.good{background:#e8f7ef;color:#176e47}.feedback.bad{background:#fff2ef;color:#99433a}
.abg{background:#10283f;color:white;border-radius:16px;padding:15px}.abg-head{display:flex;justify-content:space-between;gap:12px;color:#8fdfdc;text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;font-weight:900}.abg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:11px}.abg-cell{padding:11px 7px;text-align:center;border-radius:11px;background:rgba(255,255,255,.08)}.abg-cell span{display:block;font-size:.7rem;color:#bed3e2}.abg-cell strong{font-size:1.25rem}.case-note{margin:12px 0;padding:12px;border-left:4px solid var(--blue);border-radius:10px;background:#f2f8fd;color:var(--ink);font-size:.88rem;line-height:1.45}.compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:13px 0}.compare>div{padding:14px;border:1px solid var(--line);border-radius:14px;background:#fbfdfe}.compare h4{margin:0 0 6px;color:var(--navy)}.compare ul{margin:7px 0 0;padding-left:18px;color:var(--muted);font-size:.84rem;line-height:1.5}
.oxygen-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:13px 0}.oxygen-grid div{padding:12px;border:1px solid var(--line);border-radius:13px;background:#fbfdfe}.oxygen-grid b{display:block;font-size:.83rem;color:var(--navy)}.oxygen-grid span{font-size:.76rem;color:#147779;font-weight:800}.sentence{margin-top:11px;padding:12px 14px;border-radius:12px;background:#eaf9f7;border:1px solid #bde2de;color:#137779;font-weight:900}
.footer-nav{border-top:1px solid var(--line);margin-top:16px;padding-top:14px;display:flex;align-items:center;justify-content:space-between;gap:10px}.btn{border:0;border-radius:12px;padding:11px 15px;font-weight:900}.primary{background:linear-gradient(135deg,var(--teal),var(--blue));color:white}.secondary{background:var(--navy);color:white}.ghost{background:#edf3f6;color:var(--navy)}.btn:disabled{opacity:.42;cursor:not-allowed}.lock-note{font-size:.78rem;color:var(--muted)}
.challenge-progress{display:flex;gap:6px;margin-bottom:12px}.bar{height:7px;flex:1;border-radius:99px;background:#dfe9ee}.bar.current{background:var(--blue)}.bar.done{background:var(--teal)}.results{text-align:center}.stars{font-size:2rem;letter-spacing:5px;color:#efb33c}.skill-list{display:grid;gap:8px;margin-top:14px;text-align:left}.skill{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fbfdfe}.good-text{color:var(--ok);font-weight:900}.warn-text{color:var(--warn);font-weight:900}.review-btn{border:0;border-radius:10px;padding:7px 11px;background:#fff0d9;color:#8a5600;font-weight:900}.review-card{display:grid;gap:12px}.review-example{padding:13px;border-radius:13px;background:#f5fafc;border:1px solid var(--line)}
@media(max-width:820px){.layout{grid-template-columns:1fr}.side{position:static}.phase-list{grid-template-columns:repeat(2,1fr)}.badge{display:none}.card{min-height:0}.workflow{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.topbar-inner{align-items:flex-start}.stats{display:none}.layout{padding:10px}.hero{padding:14px}.hero h2{font-size:1.25rem}.side{padding:12px}.phase-list{display:none}.values,.oxygen-grid,.abg-grid{grid-template-columns:repeat(2,1fr)}.options,.compare{grid-template-columns:1fr}.footer-nav{align-items:flex-end}.brand-logo{width:50px;height:50px}.brand-name{font-size:1.35rem}.brand-tagline{font-size:.68rem}}
</style>
</head>
<body>
<div class="topbar"><div class="topbar-inner"><div class="brand"><img class="brand-logo" src="data:image/png;base64," alt="PulmoQuest lung logo"><div><div class="brand-name"><span class="pulmo">Pulmo</span><span class="quest">Quest</span></div><p class="brand-tagline">Interactive respiratory therapy education.</p></div></div><div class="stats"><div class="pill" id="xpPill">XP 0</div><div class="pill" id="starPill">☆☆☆</div><div class="pill" id="badgePill">Badge locked</div></div></div></div>
<div class="layout">
<aside class="side"><div class="level"><div class="eyebrow">Level 3</div><h2>Compensation Specialist</h2><p>Determine whether compensation is absent, partial, full, immediate, or appropriate for the disorder.</p><div class="track"><div class="fill" id="fill"></div></div><div class="progress-label"><span>Level progress</span><span id="progressPct">0%</span></div></div><div class="phase-list" id="phaseList"></div><div class="badge"><div class="badge-orb" id="badgeOrb">⚖️</div><strong>Compensation Specialist</strong><small id="badgeText">Earn one challenge star</small></div></aside>
<main class="main"><div class="hero"><div><div class="eyebrow">ABG Mastery Center</div><h2 id="heroTitle">Clinical Briefing</h2><p id="heroSub">Follow the evidence. Do not diagnose from one number alone.</p></div><div class="step-count" id="stepCount"></div></div><div id="screen"></div></main>
</div>
<script>
const STORAGE='pulmoquest_level3_progress';
const LEVEL_4_URL='pulmoquest_level4.html';
const defaultState={step:0,answered:{},xp:0,bestScore:0,bestStars:0,lastScore:0,lastStars:0,badge:false,challengeDone:false,lastSkillResults:{},lastMissing:[]};
let state={...defaultState,...JSON.parse(localStorage.getItem(STORAGE)||'{}')};
let challenge={active:false,index:0,answers:[],cases:[],started:0};
const phases=[
 {name:'Compensation Basics',range:[0,3]},
 {name:'7.40 Rule',range:[4,5]},
 {name:'Hydrolysis & Timing',range:[6,9]},
 {name:'Clinical Application',range:[10,12]},
 {name:'Challenge',range:[13,14]}
];
const steps=[
 {title:'Clinical Briefing',sub:'Level 3 introduces compensation and timing.',render:briefing},
 {title:'Why Compensation Happens',sub:'The body responds to oppose a primary disturbance.',render:whyCompensation},
 {title:'Compensation Categories',sub:'Recognize absent, partial, and full compensation.',render:categories},
 {title:'Direction Before Degree',sub:'Confirm the secondary value moves appropriately.',render:direction},
 {title:'The 7.40 Rule',sub:'Use pH direction when the pH is within normal limits.',render:rule740},
 {title:'7.40 Practice',sub:'Classify fully compensated disorders.',render:rulePractice},
 {title:'Hydrolysis',sub:'Separate immediate chemistry from renal compensation.',render:hydrolysis},
 {title:'Acute Respiratory Changes',sub:'Estimate the immediate bicarbonate response.',render:acuteResp},
 {title:'Chronic Respiratory Changes',sub:'Recognize time-dependent renal compensation.',render:chronicResp},
 {title:'Appropriate Compensation',sub:'Ask whether the response fits the primary disorder.',render:appropriate},
 {title:'Case Comparison',sub:'Compare acute and chronic respiratory acidosis.',render:comparison},
 {title:'Specimen and Timing Check',sub:'Do not mistake collection problems for compensation.',render:specimenTiming},
 {title:'Readiness Check',sub:'Complete an independent Level 3 case.',render:readiness},
 {title:'Challenge Briefing',sub:'Prepare for the Compensation Specialist Challenge.',render:challengeIntro},
 {title:'Compensation Challenge',sub:'Demonstrate Level 3 competency.',render:challengeScreen}
];
const pool=[
 {skill:'compensation category',type:'Partial compensation',ph:7.31,co2:58,hco3:29,o2:72,context:'A patient with worsening hypoventilation has an acidotic pH. HCO₃⁻ is elevated in the opposing direction.',answer:'Partially compensated respiratory acidosis with mild hypoxemia.'},
 {skill:'compensation category',type:'Full compensation',ph:7.37,co2:55,hco3:31,o2:67,context:'The pH is within normal limits but remains on the acidic side of 7.40.',answer:'Fully compensated respiratory acidosis with mild hypoxemia.'},
 {skill:'7.40 rule',type:'Full compensation',ph:7.43,co2:50,hco3:32,o2:88,context:'Both PaCO₂ and HCO₃⁻ are elevated. Use the pH position within the normal range.',answer:'Fully compensated metabolic alkalosis with normal oxygenation.'},
 {skill:'7.40 rule',type:'Full compensation',ph:7.36,co2:30,hco3:18,o2:91,context:'Both PaCO₂ and HCO₃⁻ are low. Use the pH position within the normal range.',answer:'Fully compensated metabolic acidosis with normal oxygenation.'},
 {skill:'hydrolysis',type:'Acute respiratory change',ph:7.25,co2:60,hco3:26,o2:75,context:'PaCO₂ rose abruptly after oversedation. The HCO₃⁻ increase is small and immediate.',answer:'Acute respiratory acidosis with hydrolysis, not established renal compensation, and mild hypoxemia.'},
 {skill:'hydrolysis',type:'Acute respiratory change',ph:7.53,co2:25,hco3:21,o2:94,context:'The patient began abruptly hyperventilating from pain. HCO₃⁻ is only slightly reduced.',answer:'Acute respiratory alkalosis with hydrolysis, not established renal compensation, and normal oxygenation.'},
 {skill:'timing',type:'Chronic respiratory disorder',ph:7.35,co2:60,hco3:32,o2:64,context:'The patient has had chronic CO₂ retention for months and is clinically stable.',answer:'Chronic fully compensated respiratory acidosis with mild hypoxemia.'},
 {skill:'appropriate response',type:'Compensation check',ph:7.26,co2:25,hco3:11,o2:86,context:'The patient has diabetic ketoacidosis. PaCO₂ has decreased in the expected compensatory direction.',answer:'Metabolic acidosis with appropriate respiratory compensation and normal oxygenation.'},
 {skill:'appropriate response',type:'Mixed disorder concern',ph:7.18,co2:60,hco3:22,o2:52,context:'Both the pH and PaCO₂ are acidotic, but HCO₃⁻ is not elevated as expected.',answer:'Respiratory acidosis with an additional metabolic acidosis and moderate hypoxemia.'},
 {skill:'specimen and timing',type:'Questionable trend',ph:7.48,co2:28,hco3:21,o2:148,context:'The sample sat uncapped with a visible air bubble before analysis. The patient is on room air.',answer:'Question and recollect the specimen before interpreting compensation.'}
];
function save(){localStorage.setItem(STORAGE,JSON.stringify(state))}
function phaseIndex(){return phases.findIndex(p=>state.step>=p.range[0]&&state.step<=p.range[1])}
function updateChrome(){
 const pct=Math.round((Math.min(state.step,14)/14)*100);document.getElementById('fill').style.width=pct+'%';document.getElementById('progressPct').textContent=pct+'%';
 document.getElementById('xp').textContent=`XP ${state.xp}`;document.getElementById('bestStars').textContent=`Best ${'★'.repeat(state.bestStars)}${'☆'.repeat(3-state.bestStars)}`;
 const pi=phaseIndex();document.getElementById('phaseList').innerHTML=phases.map((p,i)=>`<div class="phase ${i<pi?'done':i===pi?'active':''}"><span class="phase-dot">${i<pi?'✓':i+1}</span>${p.name}</div>`).join('');
 const orb=document.getElementById('badgeOrb');orb.classList.toggle('on',state.badge);document.getElementById('badgeText').textContent=state.badge?`Best rating: ${'★'.repeat(state.bestStars)}${'☆'.repeat(3-state.bestStars)}`:'Earn one challenge star';
}
function render(){if(state.step===14&&state.challengeDone&&!challenge.active){renderChallengeResults();return}const s=steps[state.step];document.getElementById('heroTitle').textContent=s.title;document.getElementById('heroSub').textContent=s.sub;document.getElementById('stepCount').textContent=`Step ${Math.min(state.step+1,14)} of 14`;s.render();updateChrome()}
function shell(body,opt={}){const answered=!!state.answered[state.step]||opt.free;return `<div class="card"><div class="content">${body}</div><div class="footer-nav"><button class="btn ghost" ${state.step===0?'disabled':''} onclick="prevStep()">Back</button><span class="lock-note">${answered?'Ready to continue.':'Answer the question to continue.'}</span><button class="btn primary" ${answered?'':'disabled'} onclick="nextStep()">${opt.nextLabel||'Next'}</button></div></div>`}
function footerQuestion(body){return shell(body)}
function setAnsweredUI(ok,id,msg,btn){document.querySelectorAll('.option').forEach(b=>b.classList.remove('correct','incorrect'));btn.classList.add(ok?'correct':'incorrect');const fb=document.getElementById(id);fb.className=`feedback show ${ok?'good':'bad'}`;fb.textContent=msg;if(ok){state.answered[state.step]=true;save();const next=document.querySelector('.footer-nav .primary');if(next)next.disabled=false;const note=document.querySelector('.lock-note');if(note)note.textContent='Correct—ready to continue.'}}
function nextStep(){if(state.step===13){startChallenge();return}if(state.step<14){state.step++;save();render()}}
function prevStep(){if(state.step>0){state.step--;save();render()}}
function briefing(){document.getElementById('screen').innerHTML=shell(`<div class="preceptor"><div class="avatar">⚖️</div><div><h3>Your compensation assignment</h3><p>Level 2 taught you to identify the primary disorder. Now you will determine what the body is doing in response—and whether that response is immediate, time-dependent, or appropriate.</p></div></div><div class="workflow"><div><span>1</span>Primary disorder</div><div><span>2</span>Direction</div><div><span>3</span>Timing</div><div><span>4</span>Degree</div><div><span>5</span>Report</div></div><div class="sentence">Compensation never fixes the primary problem. It only moves pH toward normal.</div>`,{free:true})}
function whyCompensation(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Why does compensation occur?</h3><p>The respiratory and metabolic systems respond to oppose a primary acid-base disturbance.</p><div class="compare"><div><h4>Primary respiratory disorder</h4><p>The kidneys adjust HCO₃⁻ over time.</p></div><div><h4>Primary metabolic disorder</h4><p>The lungs alter PaCO₂ through ventilation.</p></div></div><div class="quiz"><div class="question">Which system compensates for a primary metabolic acidosis?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','The kidneys are the primary system involved in the metabolic disorder itself.',this)">Kidneys by retaining more acid</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. The lungs lower PaCO₂ by increasing ventilation.',this)">Lungs by increasing ventilation</button><button class="option" onclick="setAnsweredUI(false,'fb','Oxygenation is assessed separately from compensation.',this)">Oxygen transport system</button></div><div id="fb" class="feedback"></div></div>`) }
function categories(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Three traditional categories</h3><div class="values"><div class="value"><b>Uncompensated</b><small>pH abnormal; secondary value normal</small></div><div class="value"><b>Partial</b><small>pH abnormal; secondary value also abnormal in the opposing direction</small></div><div class="value"><b>Full</b><small>pH within 7.35–7.45; both PaCO₂ and HCO₃⁻ abnormal</small></div><div class="value"><b>Not appropriate</b><small>Secondary response does not fit; consider another disorder</small></div></div><div class="quiz"><div class="question">pH 7.30, PaCO₂ 55, HCO₃⁻ 29 is best classified as:</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','HCO₃⁻ is elevated, so a secondary response is present.',this)">Uncompensated respiratory acidosis</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. The pH remains acidotic while HCO₃⁻ has risen in the opposing direction.',this)">Partially compensated respiratory acidosis</button><button class="option" onclick="setAnsweredUI(false,'fb','The pH is not within the normal range.',this)">Fully compensated respiratory acidosis</button></div><div id="fb" class="feedback"></div></div>`) }
function direction(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Direction comes first</h3><p>A secondary value is only compensatory when it moves in the direction that helps bring pH toward normal.</p><div class="case-note"><strong>Example:</strong> In metabolic acidosis, HCO₃⁻ is low. Compensation should lower PaCO₂, reducing respiratory acid.</div><div class="quiz"><div class="question">In metabolic alkalosis, which PaCO₂ change is compensatory?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','A lower PaCO₂ would increase alkalemia.',this)">PaCO₂ decreases</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. Retaining CO₂ adds respiratory acid and moves pH toward normal.',this)">PaCO₂ increases</button><button class="option" onclick="setAnsweredUI(false,'fb','Compensation generally produces a measurable directional change.',this)">PaCO₂ must stay exactly normal</button></div><div id="fb" class="feedback"></div></div>`) }
function rule740(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>The 7.40 rule</h3><p>When pH is within the normal range but PaCO₂ and HCO₃⁻ are both abnormal, use the pH's position relative to 7.40.</p><div class="compare"><div><h4>pH 7.35–7.39</h4><p>Leans acidic. The primary disorder is an acidosis.</p></div><div><h4>pH 7.41–7.45</h4><p>Leans alkaline. The primary disorder is an alkalosis.</p></div></div><div class="quiz"><div class="question">A pH of 7.37 leans in which direction?</div><div class="options"><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. Although normal, 7.37 lies on the acidic side of 7.40.',this)">Acidic</button><button class="option" onclick="setAnsweredUI(false,'fb','7.37 is below 7.40, so it leans acidic.',this)">Alkaline</button><button class="option" onclick="setAnsweredUI(false,'fb','It is normal, but its direction still helps identify the primary disorder.',this)">It has no direction</button></div><div id="fb" class="feedback"></div></div>`) }
function rulePractice(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Apply the 7.40 rule</h3><div class="abg"><div class="abg-head"><span>ABG result</span><span>Specimen accepted</span></div><div class="abg-grid"><div class="abg-cell"><span>pH</span><strong>7.43</strong></div><div class="abg-cell"><span>PaCO₂</span><strong>50</strong></div><div class="abg-cell"><span>HCO₃⁻</span><strong>32</strong></div><div class="abg-cell"><span>PaO₂</span><strong>88</strong></div></div></div><div class="quiz"><div class="question">What is the primary disorder?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','The pH leans alkaline, not acidic.',this)">Fully compensated respiratory acidosis</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. The pH leans alkaline and HCO₃⁻ is elevated, indicating metabolic alkalosis.',this)">Fully compensated metabolic alkalosis</button><button class="option" onclick="setAnsweredUI(false,'fb','The PaCO₂ is elevated rather than decreased.',this)">Fully compensated respiratory alkalosis</button></div><div id="fb" class="feedback"></div></div>`) }
function hydrolysis(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Hydrolysis is not the same as renal compensation</h3><p>When PaCO₂ changes abruptly, the carbonic acid equilibrium shifts immediately. This can cause a small HCO₃⁻ change before the kidneys have had time to respond.</p><div class="compare"><div><h4>Immediate</h4><p>Hydrolysis and buffering occur within minutes.</p></div><div><h4>Delayed</h4><p>Renal compensation develops over hours to days.</p></div></div><div class="quiz"><div class="question">PaCO₂ suddenly rises to 60 and HCO₃⁻ rises only to 26. What is the best explanation?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','Meaningful renal compensation requires time.',this)">Established chronic renal compensation</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. A small immediate HCO₃⁻ rise can reflect hydrolysis and buffering.',this)">Immediate hydrolysis and buffering</button><button class="option" onclick="setAnsweredUI(false,'fb','A metabolic alkalosis would require an independent excessive HCO₃⁻ elevation.',this)">Primary metabolic alkalosis</button></div><div id="fb" class="feedback"></div></div>`) }
function acuteResp(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Acute respiratory rules of thumb</h3><div class="values"><div class="value"><b>Acute respiratory acidosis</b><em>HCO₃⁻ rises about 1</em><small>for each 10 mmHg PaCO₂ increase</small></div><div class="value"><b>Acute respiratory alkalosis</b><em>HCO₃⁻ falls about 2</em><small>for each 10 mmHg PaCO₂ decrease</small></div><div class="value"><b>Use as estimates</b><small>Clinical context and timing still matter.</small></div><div class="value"><b>Do not over-label</b><small>A small change is not proof of chronic renal compensation.</small></div></div><div class="quiz"><div class="question">PaCO₂ acutely rises from 40 to 60. Which HCO₃⁻ is most consistent with the immediate response?</div><div class="options"><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. A 20 mmHg rise predicts an immediate HCO₃⁻ increase of about 2, from 24 to 26.',this)">26 mEq/L</button><button class="option" onclick="setAnsweredUI(false,'fb','32 suggests a larger, time-dependent renal response.',this)">32 mEq/L</button><button class="option" onclick="setAnsweredUI(false,'fb','18 would indicate an additional metabolic acidosis.',this)">18 mEq/L</button></div><div id="fb" class="feedback"></div></div>`) }
function chronicResp(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Chronic respiratory compensation</h3><p>With time, the kidneys produce a larger bicarbonate response.</p><div class="values"><div class="value"><b>Chronic respiratory acidosis</b><em>HCO₃⁻ rises about 3.5–4</em><small>per 10 mmHg PaCO₂ increase</small></div><div class="value"><b>Chronic respiratory alkalosis</b><em>HCO₃⁻ falls about 4–5</em><small>per 10 mmHg PaCO₂ decrease</small></div><div class="value"><b>Time matters</b><small>Renal adjustment requires hours to days.</small></div><div class="value"><b>Context matters</b><small>Known chronic CO₂ retention supports chronicity.</small></div></div><div class="quiz"><div class="question">PaCO₂ is chronically 60. Which HCO₃⁻ is most consistent with chronic compensation?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','26 is more consistent with an acute immediate response.',this)">26 mEq/L</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. A 20 mmHg chronic rise predicts an HCO₃⁻ near 31–32.',this)">32 mEq/L</button><button class="option" onclick="setAnsweredUI(false,'fb','20 would suggest an additional metabolic acidosis.',this)">20 mEq/L</button></div><div id="fb" class="feedback"></div></div>`) }
function appropriate(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Appropriate compensation</h3><p>Compensation should fall within an expected range. A response outside that range suggests an additional primary disorder.</p><div class="case-note"><strong>Important:</strong> Compensation does not normally overshoot and create the opposite pH disturbance.</div><div class="quiz"><div class="question">If PaCO₂ is higher than expected during metabolic acidosis, what should you suspect?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','Normal compensation should lower PaCO₂.',this)">Excellent respiratory compensation</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. Excessively high PaCO₂ suggests an additional respiratory acidosis.',this)">An additional respiratory acidosis</button><button class="option" onclick="setAnsweredUI(false,'fb','The problem is excess CO₂, not a second alkalosis.',this)">An additional respiratory alkalosis</button></div><div id="fb" class="feedback"></div></div>`) }
function comparison(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Acute versus chronic comparison</h3><div class="compare"><div><h4>Case A</h4><p>pH 7.25<br>PaCO₂ 60<br>HCO₃⁻ 26</p><strong>Acute respiratory acidosis with hydrolysis</strong></div><div><h4>Case B</h4><p>pH 7.35<br>PaCO₂ 60<br>HCO₃⁻ 32</p><strong>Chronic compensated respiratory acidosis</strong></div></div><div class="quiz"><div class="question">Which finding most strongly separates Case B from Case A?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','Both cases have the same PaCO₂.',this)">The elevated PaCO₂</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. The larger HCO₃⁻ response and near-normal pH support time-dependent renal compensation.',this)">The larger HCO₃⁻ increase and near-normal pH</button><button class="option" onclick="setAnsweredUI(false,'fb','Oxygenation values were not provided in this comparison.',this)">The PaO₂ category</button></div><div id="fb" class="feedback"></div></div>`) }
function specimenTiming(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Verify the story before naming compensation</h3><p>Timing and sample quality can create values that appear compensated or contradictory.</p><div class="review-card"><div class="review-example"><strong>Ask:</strong> Was the change acute or chronic?</div><div class="review-example"><strong>Check:</strong> Were oxygen or ventilator settings changed shortly before collection?</div><div class="review-example"><strong>Verify:</strong> Was the sample delayed, exposed to air, or possibly venous?</div></div><div class="quiz"><div class="question">A room-air ABG with a documented air bubble reports PaO₂ 148 and PaCO₂ 28. Best action?</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','The specimen concern must be addressed before interpreting compensation.',this)">Call it compensated respiratory alkalosis</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. Air exposure can alter gas tensions; verify or recollect before interpreting.',this)">Question and recollect the sample</button><button class="option" onclick="setAnsweredUI(false,'fb','The values conflict with room air and documented air exposure.',this)">Accept it as a normal variant</button></div><div id="fb" class="feedback"></div></div>`) }
function readiness(){document.getElementById('screen').innerHTML=footerQuestion(`<h3>Independent readiness case</h3><div class="abg"><div class="abg-head"><span>ABG result</span><span>Chronic CO₂ retainer</span></div><div class="abg-grid"><div class="abg-cell"><span>pH</span><strong>7.36</strong></div><div class="abg-cell"><span>PaCO₂</span><strong>58</strong></div><div class="abg-cell"><span>HCO₃⁻</span><strong>31</strong></div><div class="abg-cell"><span>PaO₂</span><strong>68</strong></div></div></div><div class="quiz"><div class="question">Choose the best interpretation.</div><div class="options"><button class="option" onclick="setAnsweredUI(false,'fb','The pH is within normal limits and HCO₃⁻ is elevated.',this)">Uncompensated respiratory acidosis</button><button class="option" data-correct="1" onclick="setAnsweredUI(true,'fb','Correct. The pH leans acidic, PaCO₂ is elevated, and the larger HCO₃⁻ response supports chronic full compensation.',this)">Chronic fully compensated respiratory acidosis with mild hypoxemia</button><button class="option" onclick="setAnsweredUI(false,'fb','The pH does not lean alkaline and HCO₃⁻ is not the primary cause.',this)">Fully compensated metabolic alkalosis</button></div><div id="fb" class="feedback"></div></div>`) }
function challengeIntro(){document.getElementById('screen').innerHTML=shell(`<h3>Compensation Specialist Challenge</h3><p>Six encounters will test compensation category, 7.40 reasoning, hydrolysis, timing, appropriate response, and sample validation.</p><div class="values"><div class="value"><b>6 cases</b><small>Balanced Level 3 mix</small></div><div class="value"><b>60 seconds</b><small>Recommended per case</small></div><div class="value"><b>Unlimited retries</b><small>Best stars are retained</small></div><div class="value"><b>2 stars</b><small>Unlocks Level 4</small></div></div>`,{free:true,nextLabel:'Begin Challenge'})}
function challengeScreen(){if(!challenge.active&&!state.challengeDone){startChallenge();return}if(!challenge.active&&state.challengeDone){renderChallengeResults();return}renderChallengeCase()}
function pickCases(){const groups=['compensation category','7.40 rule','hydrolysis','timing','appropriate response','specimen and timing'];return groups.map(g=>{const arr=pool.filter(c=>c.skill===g);return arr[Math.floor(Math.random()*arr.length)]})}
function startChallenge(){challenge={active:true,index:0,answers:[],cases:pickCases(),started:Date.now()};state.step=14;save();renderChallengeCase()}
function challengeChoices(c){const all=[
 'Partially compensated respiratory acidosis with mild hypoxemia.',
 'Fully compensated respiratory acidosis with mild hypoxemia.',
 'Fully compensated metabolic alkalosis with normal oxygenation.',
 'Fully compensated metabolic acidosis with normal oxygenation.',
 'Acute respiratory acidosis with hydrolysis, not established renal compensation, and mild hypoxemia.',
 'Acute respiratory alkalosis with hydrolysis, not established renal compensation, and normal oxygenation.',
 'Chronic fully compensated respiratory acidosis with mild hypoxemia.',
 'Metabolic acidosis with appropriate respiratory compensation and normal oxygenation.',
 'Respiratory acidosis with an additional metabolic acidosis and moderate hypoxemia.',
 'Question and recollect the specimen before interpreting compensation.'
 ];return [c.answer,...all.filter(x=>x!==c.answer).sort(()=>Math.random()-.5).slice(0,3)].sort(()=>Math.random()-.5)}
function renderChallengeCase(){const c=challenge.cases[challenge.index];document.getElementById('heroTitle').textContent='Compensation Specialist Challenge';document.getElementById('heroSub').textContent='Interpret compensation independently.';document.getElementById('stepCount').textContent=`Case ${challenge.index+1} of ${challenge.cases.length}`;const choices=challengeChoices(c);document.getElementById('screen').innerHTML=`<div class="card"><div class="content"><div class="challenge-progress">${challenge.cases.map((_,i)=>`<div class="bar ${i<challenge.index?'done':i===challenge.index?'current':''}"></div>`).join('')}</div><div class="abg"><div class="abg-head"><span>${c.type}</span><span>Specimen review included</span></div><div class="abg-grid"><div class="abg-cell"><span>pH</span><strong>${c.ph.toFixed(2)}</strong></div><div class="abg-cell"><span>PaCO₂</span><strong>${c.co2}</strong></div><div class="abg-cell"><span>HCO₃⁻</span><strong>${c.hco3}</strong></div><div class="abg-cell"><span>PaO₂</span><strong>${c.o2}</strong></div></div></div><div class="case-note">${c.context}</div><div class="quiz"><div class="question">Choose the best interpretation or action.</div><div class="options">${choices.map((x,i)=>`<button class="option" data-index="${i}">${x}</button>`).join('')}</div></div></div><div class="footer-nav"><button class="btn ghost" onclick="exitChallenge()">Exit challenge</button><span class="lock-note">Choose an answer to continue.</span><button class="btn primary" disabled>Next case</button></div></div>`;document.querySelectorAll('.option').forEach(btn=>btn.addEventListener('click',()=>answerChallenge(btn.textContent)))}
function answerChallenge(ans){const c=challenge.cases[challenge.index],ok=ans===c.answer;challenge.answers.push({skill:c.skill,ok});challenge.index++;if(challenge.index>=challenge.cases.length)finishChallenge();else renderChallengeCase()}
function exitChallenge(){challenge.active=false;state.step=13;save();render()}
function finishChallenge(){challenge.active=false;const correct=challenge.answers.filter(a=>a.ok).length;const score=Math.round(correct/challenge.answers.length*100);const stars=score>=95?3:score>=83?2:score>=67?1:0;const skillNames=['compensation category','7.40 rule','hydrolysis','timing','appropriate response','specimen and timing'];const results={};skillNames.forEach(skill=>{const items=challenge.answers.filter(a=>a.skill===skill);const n=items.filter(a=>a.ok).length;results[skill]={correct:n,total:items.length,passed:items.length>0&&n===items.length}});state.lastScore=score;state.lastStars=stars;state.lastSkillResults=results;state.lastMissing=skillNames.filter(s=>!results[s].passed);state.bestScore=Math.max(state.bestScore,score);state.bestStars=Math.max(state.bestStars,stars);state.badge=state.bestStars>=1;state.challengeDone=true;state.xp+=score;save();renderChallengeResults()}
function renderChallengeResults(){const skills=['compensation category','7.40 rule','hydrolysis','timing','appropriate response','specimen and timing'];const rows=skills.map(skill=>{const r=(state.lastSkillResults||{})[skill]||{correct:0,total:1,passed:false};const label=skill.replace(/\b\w/g,m=>m.toUpperCase());if(r.passed)return `<div class="skill"><span>${label}</span><span class="good-text">Demonstrated (${r.correct}/${r.total})</span></div>`;return `<div class="skill"><span>${label}</span><span class="warn-text">${r.correct?'Developing':'Needs review'} (${r.correct}/${r.total})</span><button class="review-btn" onclick="reviewSkill('${skill}')">Review</button></div>`}).join('');document.getElementById('heroTitle').textContent='Challenge Results';document.getElementById('heroSub').textContent='Review missed competencies and improve your stars.';document.getElementById('stepCount').textContent='Level 3 results';document.getElementById('screen').innerHTML=`<div class="card"><div class="content results"><div class="stars">${'★'.repeat(state.lastStars)}${'☆'.repeat(3-state.lastStars)}</div><h3>${state.lastStars?'Challenge complete':'Review recommended'}</h3><p>Latest score: <strong>${state.lastScore}%</strong>${state.bestScore>state.lastScore?` &nbsp;•&nbsp; Best score: <strong>${state.bestScore}%</strong>`:''}</p>${state.badge?'<div class="sentence">Badge earned: Compensation Specialist</div>':'<p>Earn at least 67% to unlock the badge.</p>'}<div class="skill-list">${rows}</div></div><div class="footer-nav"><button class="btn ghost" onclick="resetLevel()">Reset Level</button><span class="lock-note">${state.bestStars>=2?'Level 4 unlocked. You may still retry for three stars.':'Earn at least two stars to unlock Level 4.'}</span><div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end"><button class="btn ghost" onclick="startChallenge()">Retry Challenge</button>${state.bestStars>=2?'<button class="btn primary" onclick="goToLevel4()">Continue to Level 4</button>':''}</div></div></div>`;updateChrome()}
function reviewSkill(skill){const reviews={
 'compensation category':{title:'Review: Compensation Categories',body:`<div class="review-card"><div class="review-example"><strong>Uncompensated:</strong> pH abnormal; secondary value normal.</div><div class="review-example"><strong>Partial:</strong> pH abnormal; secondary value moves appropriately.</div><div class="review-example"><strong>Full:</strong> pH normal; both PaCO₂ and HCO₃⁻ abnormal.</div></div>`},
 '7.40 rule':{title:'Review: 7.40 Rule',body:`<div class="review-card"><div class="review-example"><strong>7.35–7.39:</strong> acid side.</div><div class="review-example"><strong>7.41–7.45:</strong> alkaline side.</div><div class="review-example">Match that direction to PaCO₂ or HCO₃⁻ to identify the primary disorder.</div></div>`},
 'hydrolysis':{title:'Review: Hydrolysis',body:`<div class="review-card"><div class="review-example">A small immediate HCO₃⁻ change after an abrupt PaCO₂ change reflects carbonic acid equilibrium and buffering.</div><div class="review-example">Do not call it established renal compensation without enough time or a larger expected response.</div></div>`},
 'timing':{title:'Review: Acute vs Chronic',body:`<div class="review-card"><div class="review-example"><strong>Acute respiratory acidosis:</strong> HCO₃⁻ rises about 1 per 10 PaCO₂.</div><div class="review-example"><strong>Chronic respiratory acidosis:</strong> HCO₃⁻ rises about 3.5–4 per 10 PaCO₂.</div></div>`},
 'appropriate response':{title:'Review: Appropriate Compensation',body:`<div class="review-card"><div class="review-example">The secondary response should oppose the pH disturbance and fall within an expected range.</div><div class="review-example">Too little or too much change suggests an additional primary disorder.</div></div>`},
 'specimen and timing':{title:'Review: Specimen and Timing',body:`<div class="review-card"><div class="review-example">Confirm collection quality, oxygen/ventilator settings, and whether enough time passed after a clinical change.</div><div class="review-example">Recollect clearly compromised samples before interpreting compensation.</div></div>`}
};const r=reviews[skill];document.getElementById('heroTitle').textContent=r.title;document.getElementById('heroSub').textContent='Targeted competency review';document.getElementById('stepCount').textContent='Review';document.getElementById('screen').innerHTML=`<div class="card"><div class="content"><h3>${r.title}</h3>${r.body}</div><div class="footer-nav"><button class="btn ghost" onclick="renderChallengeResults()">Back to Results</button><span class="lock-note">Review complete when you feel ready.</span><button class="btn primary" onclick="startChallenge()">Retry Challenge</button></div></div>`}
function goToLevel4(){window.location.href=LEVEL_4_URL}
function resetLevel(){if(confirm('Reset all Level 3 progress?')){localStorage.removeItem(STORAGE);state={...defaultState,answered:{}};challenge={active:false,index:0,answers:[],cases:[],started:0};render()}}
render();
</script>
